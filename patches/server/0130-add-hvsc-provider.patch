index 0000000..ebe8438
--- /dev/null
+++ b/music_assistant/providers/hvsc/sid_parser.py
@@ -0,0 +1,156 @@
+"""SID file binary header parser and HVSC Songlengths database parser."""
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+
+from .constants import DEFAULT_DURATION_SECONDS
+
+
+@dataclass
+class SidHeader:
+    """Parsed Commodore 64 SID file header information."""
+
+    magic: str
+    version: int
+    data_offset: int
+    load_address: int
+    init_address: int
+    play_address: int
+    songs: int
+    start_song: int
+    speed: int
+    title: str
+    author: str
+    released: str
+    flags: int = 0
+    sid_model: str = "MOS6581"
+    clock: str = "PAL"
+
+
+def _clean_str(raw: bytes) -> str:
+    """Decode raw bytes using ISO-8859-1 and strip null terminators / whitespace."""
+    null_idx = raw.find(b"\x00")
+    if null_idx != -1:
+        raw = raw[:null_idx]
+    return raw.decode("iso-8859-1", errors="replace").strip()
+
+
+def parse_sid_header(data: bytes) -> SidHeader:
+    """Parse PSID or RSID binary header from raw file bytes.
+
+    Specification:
+    Bytes 0-3: Magic ID ('PSID' or 'RSID')
+    Bytes 4-5: Version (0x0001 - 0x0004)
+    Bytes 6-7: Data offset (0x0076 for v1, 0x007C for v2+)
+    Bytes 8-9: Load address
+    Bytes 10-11: Init address
+    Bytes 12-13: Play address
+    Bytes 14-15: Songs count (subtunes)
+    Bytes 16-17: Start song (1-indexed default subtune)
+    Bytes 18-21: Speed flags (32-bit big endian)
+    Bytes 22-53: Name / Title (32 bytes)
+    Bytes 54-85: Author / Composer (32 bytes)
+    Bytes 86-117: Released / Copyright (32 bytes)
+    Bytes 118-119: Flags (v2+)
+    """
+    if len(data) < 0x0076:
+        msg = f"Data too short for SID header ({len(data)} bytes, minimum 118 bytes)"
+        raise ValueError(msg)
+
+    magic = data[0:4]
+    if magic not in (b"PSID", b"RSID"):
+        msg = f"Invalid SID magic identifier: {magic!r}, expected PSID or RSID"
+        raise ValueError(msg)
+
+    version, data_offset, load_addr, init_addr, play_addr, songs, start_song, speed = (
+        struct.unpack_from(">HHHHHHHI", data, 4)
+    )
+
+    title = _clean_str(data[22:54])
+    author = _clean_str(data[54:86])
+    released = _clean_str(data[86:118])
+
+    flags = 0
+    sid_model = "MOS6581"
+    clock = "PAL"
+
+    if version >= 2 and len(data) >= 0x0078:
+        (flags,) = struct.unpack_from(">H", data, 118)
+
+        # Clock bits 6-7: 01=PAL, 10=NTSC, 11=both
+        clock_bits = (flags >> 2) & 0x03
+        if clock_bits == 2:
+            clock = "NTSC"
+        elif clock_bits == 3:
+            clock = "PAL/NTSC"
+
+        # SID model bits 8-11: 01=MOS6581, 10=CSG8580, 11=both
+        sid_bits = (flags >> 4) & 0x03
+        if sid_bits == 2:
+            sid_model = "CSG8580"
+        elif sid_bits == 3:
+            sid_model = "MOS6581 / CSG8580"
+
+    return SidHeader(
+        magic=magic.decode("ascii"),
+        version=version,
+        data_offset=data_offset,
+        load_address=load_addr,
+        init_address=init_addr,
+        play_address=play_addr,
+        songs=max(1, songs),
+        start_song=max(1, start_song),
+        speed=speed,
+        title=title or "Unknown Title",
+        author=author or "Unknown Composer",
+        released=released or "Unknown",
+        flags=flags,
+        sid_model=sid_model,
+        clock=clock,
+    )
+
+
+def parse_duration_seconds(duration_str: str) -> int:
+    """Parse MM:SS or MM:SS.xxx into integer seconds."""
+    clean = duration_str.strip().split(".")[0]
+    parts = clean.split(":")
+    if len(parts) == 2:
+        try:
+            minutes = int(parts[0])
+            seconds = int(parts[1])
+            return minutes * 60 + seconds
+        except ValueError:
+            return DEFAULT_DURATION_SECONDS
+    elif len(parts) == 3:
+        try:
+            hours = int(parts[0])
+            minutes = int(parts[1])
+            seconds = int(parts[2])
+            return hours * 3600 + minutes * 60 + seconds
+        except ValueError:
+            return DEFAULT_DURATION_SECONDS
+    return DEFAULT_DURATION_SECONDS
+
+
+def parse_songlengths(content: str) -> dict[str, list[int]]:
+    """Parse HVSC Songlengths.txt / Songlengths.md5 database.
+
+    Lines format:
+    /MUSICIANS/H/Hubbard_Rob/Commando.sid=3:25 1:12 0:45
+    or MD5 hash format:
+    a1b2c3d4e5f6...=1:35 2:40 0:45
+    """
+    lengths_db: dict[str, list[int]] = {}
+    for line in content.splitlines():
+        line = line.strip()
+        if not line or line.startswith((";", "[")):
+            continue
+        if "=" in line:
+            key, times_str = line.split("=", 1)
+            key = key.strip()
+            times = [parse_duration_seconds(t) for t in times_str.strip().split() if t]
+            if times:
+                lengths_db[key] = times
+    return lengths_db
