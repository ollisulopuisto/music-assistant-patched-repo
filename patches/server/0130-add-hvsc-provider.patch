+    # Tim Follin
+    Tune("MUSICIANS/F/Follin_Tim/Ghouls_n_Ghosts.sid", "Ghouls 'n Ghosts", "Follin_Tim", "Tim Follin", 7, 1, "1989", "US Gold/Capcom", "MUSICIANS/F/Follin_Tim/Ghouls_n_Ghosts.sid", [360, 280, 240, 190, 120, 60, 30]),
+    Tune("MUSICIANS/F/Follin_Tim/Bionic_Commando.sid", "Bionic Commando", "Follin_Tim", "Tim Follin", 5, 1, "1988", "Go!", "MUSICIANS/F/Follin_Tim/Bionic_Commando.sid", [320, 210, 180, 90, 30]),
+    Tune("MUSICIANS/F/Follin_Tim/LED_Storm.sid", "LED Storm", "Follin_Tim", "Tim Follin", 6, 1, "1989", "Go!", "MUSICIANS/F/Follin_Tim/LED_Storm.sid", [340, 260, 190, 150, 80, 30]),
+
+    # Matt Gray
+    Tune("MUSICIANS/G/Gray_Matt/Last_Ninja_2.sid", "Last Ninja 2: Central Park", "Gray_Matt", "Matt Gray", 12, 1, "1988", "System 3", "MUSICIANS/G/Gray_Matt/Last_Ninja_2.sid", [370, 330, 310, 290, 270, 250, 220, 180, 150, 120, 90, 45]),
+    Tune("MUSICIANS/G/Gray_Matt/Dominator.sid", "Dominator", "Gray_Matt", "Matt Gray", 3, 1, "1989", "System 3", "MUSICIANS/G/Gray_Matt/Dominator.sid", [320, 180, 60]),
+
+    # Mark Cooksey
+    Tune("MUSICIANS/C/Cooksey_Mark/Ghosts_n_Goblins.sid", "Ghosts 'n Goblins", "Cooksey_Mark", "Mark Cooksey", 4, 1, "1986", "Elite", "MUSICIANS/C/Cooksey_Mark/Ghosts_n_Goblins.sid", [280, 120, 60, 20]),
+    Tune("MUSICIANS/C/Cooksey_Mark/Paperboy.sid", "Paperboy", "Cooksey_Mark", "Mark Cooksey", 3, 1, "1986", "Elite", "MUSICIANS/C/Cooksey_Mark/Paperboy.sid", [220, 90, 30]),
+    Tune("MUSICIANS/C/Cooksey_Mark/Bomb_Jack.sid", "Bomb Jack", "Cooksey_Mark", "Mark Cooksey", 5, 1, "1986", "Elite", "MUSICIANS/C/Cooksey_Mark/Bomb_Jack.sid", [190, 150, 120, 60, 20]),
+
+    # Reyn Ouwehand
+    Tune("MUSICIANS/O/Ouwehand_Reyn/Flimbos_Quest.sid", "Flimbo's Quest", "Ouwehand_Reyn", "Reyn Ouwehand", 6, 1, "1990", "System 3", "MUSICIANS/O/Ouwehand_Reyn/Flimbos_Quest.sid", [330, 290, 250, 180, 90, 45]),
+    Tune("MUSICIANS/O/Ouwehand_Reyn/Last_Ninja_3.sid", "Last Ninja 3", "Ouwehand_Reyn", "Reyn Ouwehand", 8, 1, "1991", "System 3", "MUSICIANS/O/Ouwehand_Reyn/Last_Ninja_3.sid", [360, 310, 280, 240, 190, 150, 90, 40]),
+]
+
+
+class HvscCatalog:
+    """Provides categorized access and fast search to HVSC music metadata."""
+
+    def __init__(self, local_hvsc_path: str | Path | None = None) -> None:
+        self.composers: dict[str, Composer] = {c.item_id: c for c in BUILTIN_COMPOSERS}
+        self.tunes: dict[str, Tune] = {t.item_id: t for t in BUILTIN_TUNES}
+        self.local_hvsc_path = Path(local_hvsc_path) if local_hvsc_path else None
+
+    def get_featured_composers(self) -> list[Composer]:
+        """Return list of featured legendary C64 composers."""
+        return list(self.composers.values())
+
+    def get_top_tunes(self) -> list[Tune]:
+        """Return collection of classic and legendary SID tunes."""
+        return list(self.tunes.values())
+
+    def get_composer(self, composer_id: str) -> Composer | None:
+        """Find composer by identifier."""
+        return self.composers.get(composer_id)
+
+    def get_tune(self, tune_id: str) -> Tune | None:
+        """Find tune by item ID."""
+        clean_id = tune_id.split("#")[0]
+        return self.tunes.get(clean_id)
+
+    def get_tunes_by_composer(self, composer_id: str) -> list[Tune]:
+        """Return all tunes composed by a specific musician."""
+        return [t for t in self.tunes.values() if t.composer_id == composer_id]
+
+    def browse_root(self) -> list[CatalogBrowseFolder]:
+        """Return top-level categories for Music Assistant browser."""
+        return [
+            CatalogBrowseFolder("featured", "🌟 Featured Composers", "Legendary SID composers (Rob Hubbard, Martin Galway, Chris Hülsbeck, Jeroen Tel, ...)"),
+            CatalogBrowseFolder("top100", "🏆 Top Legendary SID Tunes", "The most iconic Commodore 64 game and demo tunes of all time"),
+            CatalogBrowseFolder("musicians", "👨‍🎤 Musicians A-Z", "Browse composers by alphabetical letter"),
+            CatalogBrowseFolder("games", "🎮 Games Soundtracks", "Commodore 64 game music collection"),
+        ]
+
+    def browse_musicians_letter(self, letter: str) -> list[Composer]:
+        """Return all composers whose surname/folder starts with the given letter."""
+        let = letter.upper()
+        return [c for c in self.composers.values() if c.item_id.upper().startswith(let)]
+
+    def search(self, query: str) -> dict[str, list[Composer | Tune]]:
+        """Search composers and tune titles matching the query string."""
+        q = query.lower().strip()
+        matched_artists = [
+            c for c in self.composers.values()
+            if q in c.name.lower() or q in c.item_id.lower() or (c.handle and q in c.handle.lower())
+        ]
+        matched_tracks = [
+            t for t in self.tunes.values()
+            if q in t.title.lower() or q in t.composer_name.lower() or q in t.publisher.lower()
+        ]
+        return {
+            "artists": matched_artists,
+            "tracks": matched_tracks,
+        }
