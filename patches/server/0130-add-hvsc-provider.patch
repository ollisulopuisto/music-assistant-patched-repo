+"""Music Assistant Provider implementation for High Voltage SID Collection (HVSC)."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import AsyncGenerator, Sequence
+from typing import TYPE_CHECKING, Any
+
+from music_assistant_models.config_entries import (
+    ConfigEntry,
+    ConfigValueOption,
+    ConfigValueType,
+)
+from music_assistant_models.enums import (
+    ConfigEntryType,
+    ContentType,
+    MediaType,
+    ProviderFeature,
+    StreamType,
+)
+from music_assistant_models.errors import MediaNotFoundError
+from music_assistant_models.media_items import (
+    Artist,
+    AudioFormat,
+    BrowseFolder,
+    ItemMapping,
+    MediaItemType,
+    ProviderMapping,
+    SearchResults,
+    Track,
+    UniqueList,
+)
+from music_assistant_models.streamdetails import StreamDetails
+
+from .audio_engine import AudioEngine, SidChipModel
+from .catalog import Composer, HvscCatalog, Tune
+from .constants import (
+    CONF_DEFAULT_DURATION,
+    CONF_EMULATOR_CMD,
+    CONF_FADE_OUT_DURATION,
+    CONF_HVSC_URL,
+    CONF_LOCAL_HVSC_PATH,
+    CONF_SID_CHIP,
+    CONF_STEREO_WIDTH,
+    DEFAULT_DURATION_SECONDS,
+    DEFAULT_EMULATOR_CMD,
+    DEFAULT_FADE_OUT_SECONDS,
+    DEFAULT_HVSC_BASE_URL,
+    DEFAULT_STEREO_WIDTH,
+)
+
+if TYPE_CHECKING:
+    from music_assistant_models.config_entries import ProviderConfig
+    from music_assistant_models.provider import ProviderManifest
+
+LOGGER = logging.getLogger(__name__)
+
+SUPPORTED_FEATURES = {
+    ProviderFeature.BROWSE,
+    ProviderFeature.SEARCH,
+    ProviderFeature.SIMILAR_TRACKS,
+}
+
+# Dynamic base class: inherit from real MusicProvider if inside Music Assistant,
+# else provide a standalone shim for unit testing and independent usage.
+try:
+    from music_assistant.models.music_provider import MusicProvider
+except ImportError:
+
+    class MusicProvider:  # type: ignore[no-redef]
+        """Shim for MusicProvider when running outside Music Assistant server."""
+
+        def __init__(
+            self,
+            mass: Any,
+            manifest: ProviderManifest,
+            config: ProviderConfig,
+            supported_features: set[ProviderFeature] | None = None,
+        ) -> None:
+            self.mass = mass
+            self.manifest = manifest
+            self.config = config
+            self.supported_features = supported_features or SUPPORTED_FEATURES
+            self.domain = manifest.domain
+            self.instance_id = config.instance_id
+
+
+class HvscProvider(MusicProvider):
+    """High Voltage SID Collection Music Provider for Music Assistant."""
+
+    def __init__(
+        self,
+        mass: Any,
+        manifest: ProviderManifest,
+        config: ProviderConfig,
+        supported_features: set[ProviderFeature] | None = None,
+    ) -> None:
+        super().__init__(
+            mass, manifest, config, supported_features or SUPPORTED_FEATURES
+        )
+        self.catalog = HvscCatalog()
+        self._init_audio_engine()
+
+    def _get_config_value(self, key: str, default: Any = None) -> Any:
+        """Safely retrieve a configuration value whether config is ProviderConfig or dict."""
+        val = None
+        if hasattr(self.config, "get_value"):
+            try:
+                val = self.config.get_value(key)
+            except (KeyError, AttributeError, TypeError):
+                val = None
+        if val is None:
+            cfg_values = getattr(self.config, "values", {}) or {}
+            raw = cfg_values.get(key)
+            if raw is not None:
+                if hasattr(raw, "value"):
+                    val = raw.value
+                else:
+                    val = raw
+        if val is None:
+            return default
+        if hasattr(val, "value"):
+            configured_value = val.value
+            val = (
+                configured_value
+                if configured_value is not None
+                else getattr(val, "default_value", default)
+            )
+        return val if val is not None else default
+
+    def _init_audio_engine(self) -> None:
+        """Initialize or update the audio engine using current configuration values."""
+        base_url = self._get_config_value(CONF_HVSC_URL, DEFAULT_HVSC_BASE_URL)
+        chip_model = self._get_config_value(CONF_SID_CHIP, SidChipModel.MOS6581R3.value)
+        emulator_cmd = self._get_config_value(CONF_EMULATOR_CMD, DEFAULT_EMULATOR_CMD)
+        local_path = self._get_config_value(CONF_LOCAL_HVSC_PATH, None)
+
+        self.audio_engine = AudioEngine(
+            base_url=base_url,
+            chip_model=chip_model,
+            emulator_binary=emulator_cmd,
+            local_hvsc_path=local_path,
+            stereo_width=self._get_config_value(
+                CONF_STEREO_WIDTH, DEFAULT_STEREO_WIDTH
+            ),
+            fade_out_seconds=self._get_config_value(
+                CONF_FADE_OUT_DURATION, DEFAULT_FADE_OUT_SECONDS
+            ),
+        )
+
+    async def get_config_entries(
+        self,
+        action: str | None = None,
+        values: dict[str, ConfigValueType] | None = None,
+    ) -> tuple[ConfigEntry, ...]:
+        """Return configuration entries exposed to the Music Assistant settings UI."""
+        return (
+            ConfigEntry(
+                key=CONF_SID_CHIP,
+                type=ConfigEntryType.STRING,
+                label="Preferred SID Chip Model",
+                default_value=SidChipModel.MOS6581R3.value,
+                options=[
+                    ConfigValueOption(
+                        SidChipModel.MOS6581R3.value,
+                        "MOS 6581 (classic C64 SID)",
+                    ),
+                    ConfigValueOption(
+                        SidChipModel.CSG8580R5.value,
+                        "CSG 8580 R5 (Clean, sharp C64C filter)",
+                    ),
+                ],
+                description="Choose the Commodore 64 SID chip revision for playback.",
+            ),
+            ConfigEntry(
+                key=CONF_HVSC_URL,
+                type=ConfigEntryType.STRING,
+                label="HVSC SID Mirror Base URL",
+                default_value=DEFAULT_HVSC_BASE_URL,
+                description="Base URL used to fetch .sid files before rendering them with sidplayfp.",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_LOCAL_HVSC_PATH,
+                type=ConfigEntryType.STRING,
+                label="Local HVSC Path",
+                default_value="",
+                required=False,
+                description="Optional path to local C64Music directory (for local file playback).",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_EMULATOR_CMD,
+                type=ConfigEntryType.STRING,
+                label="Emulator Executable Command",
+                default_value=DEFAULT_EMULATOR_CMD,
+                description="Binary path or command for SID emulator (e.g. sidplayfp).",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_STEREO_WIDTH,
+                type=ConfigEntryType.INTEGER,
+                label="Stereo Width",
+                default_value=DEFAULT_STEREO_WIDTH,
+                range=(0, 100),
+                description=(
+                    "Widen rendered SID audio with a high-passed, 8 ms delayed side signal. "
+                    "0 disables the effect; higher values increase its intensity."
+                ),
+                advanced=True,
+                requires_reload=True,
+            ),
+            ConfigEntry(
+                key=CONF_DEFAULT_DURATION,
+                type=ConfigEntryType.INTEGER,
+                label="Default Track Duration (seconds)",
+                default_value=DEFAULT_DURATION_SECONDS,
+                range=(30, 1800),
+                description=(
+                    "Playback limit used when no HVSC song length is available. "
+                    "Known song lengths from HVSC take precedence."
+                ),
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_FADE_OUT_DURATION,
+                type=ConfigEntryType.INTEGER,
+                label="Fade Out Duration (seconds)",
+                default_value=DEFAULT_FADE_OUT_SECONDS,
+                range=(0, 30),
+                description="Fade the rendered SID audio to silence before its playback limit.",
+                advanced=True,
+                requires_reload=True,
+            ),
+        )
+
+    async def handle_async_init(self) -> None:
+        """Handle asynchronous initialization when loaded into Music Assistant."""
+        self._init_audio_engine()
+        LOGGER.info("High Voltage SID Collection provider initialized successfully.")
+
+    async def search(
+        self,
+        search_query: str,
+        media_types: list[MediaType],
+        limit: int = 10,
+    ) -> SearchResults:
+        """Search HVSC for composers and tracks matching the search query."""
+        results = self.catalog.search(search_query)
+        artists: list[Artist] = []
+        tracks: list[Track] = []
+
+        if MediaType.ARTIST in media_types:
+            for composer in results["artists"][:limit]:
+                artists.append(self._composer_to_artist(composer))
+
+        if MediaType.TRACK in media_types:
+            for tune in results["tracks"][:limit]:
+                # Add default subtune as track
+                tracks.append(self._tune_to_track(tune, subtune=tune.default_subtune))
+
+        return SearchResults(
+            artists=artists,
+            tracks=tracks,
+        )
+
+    async def browse(
+        self, path: str
+    ) -> Sequence[MediaItemType | ItemMapping | BrowseFolder]:
+        """Browse HVSC directory structure."""
+        # Music Assistant passes provider browse paths as instance_id://path.
+        # Keep accepting plain paths too, which is useful for direct callers.
+        browse_path = path or ""
+        if "://" in browse_path:
+            _, _, browse_path = browse_path.partition("://")
+        clean_path = browse_path.strip("/")
+
+        # Root browsing
+        if not clean_path:
+            folders = self.catalog.browse_root()
+            return [
+                BrowseFolder(
+                    item_id=f.item_id,
+                    provider=self.instance_id,
+                    path=self._browse_uri(f.item_id),
+                    name=f.name,
+                )
+                for f in folders
+            ]
+
+        # Top 100 / Classic tunes
+        if clean_path == "top100":
+            return [
+                self._tune_to_track(tune, subtune=tune.default_subtune)
+                for tune in self.catalog.get_top_tunes()
+            ]
+
+        # Featured composers
+        if clean_path == "featured":
+            return [
+                self._composer_to_browse_folder(composer)
+                for composer in self.catalog.get_featured_composers()
+            ]
+
+        # Musicians A-Z root
+        if clean_path == "musicians":
+            letters = [chr(c) for c in range(ord("A"), ord("Z") + 1)]
+            return [
+                BrowseFolder(
+                    item_id=f"musicians/{letter}",
+                    provider=self.instance_id,
+                    path=self._browse_uri(f"musicians/{letter}"),
+                    name=f"Musicians: {letter}",
+                )
+                for letter in letters
+            ]
+
+        # Musicians letter (e.g. "musicians/H")
+        if clean_path.startswith("musicians/"):
+            letter = clean_path.split("/")[-1]
+            composers = self.catalog.browse_musicians_letter(letter)
+            return [self._composer_to_browse_folder(c) for c in composers]
+
+        # Composer folder (e.g. "musician/Hubbard_Rob")
+        if clean_path.startswith("musician/"):
+            composer_id = clean_path.split("/", 1)[1]
+            tunes = self.catalog.get_tunes_by_composer(composer_id)
+            track_items: list[Track] = []
+            for tune in tunes:
+                for subtune in range(1, tune.subtunes_count + 1):
+                    track_items.append(self._tune_to_track(tune, subtune=subtune))
+            return track_items
+
+        # Games category
+        if clean_path == "games":
+            return [
+                self._tune_to_track(tune, subtune=tune.default_subtune)
+                for tune in self.catalog.get_top_tunes()
+            ]
+
+        return []
+
+    async def get_artist(self, prov_artist_id: str) -> Artist:
+        """Get composer artist details."""
+        composer = self.catalog.get_composer(prov_artist_id)
+        if not composer:
+            msg = f"Composer {prov_artist_id} not found"
+            raise MediaNotFoundError(msg)
+        return self._composer_to_artist(composer)
+
+    async def get_artist_tracks(self, prov_artist_id: str) -> list[Track]:
+        """Get all tracks composed by this artist."""
+        tunes = self.catalog.get_tunes_by_composer(prov_artist_id)
+        tracks: list[Track] = []
+        for tune in tunes:
+            for s in range(1, tune.subtunes_count + 1):
+                tracks.append(self._tune_to_track(tune, subtune=s))
+        return tracks
+
+    async def get_track(self, prov_track_id: str) -> Track:
+        """Get track metadata from item ID."""
+        # Item ID format: <hvsc_path>#<subtune>
+        parts = prov_track_id.split("#")
+        tune_id = parts[0]
+        subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+
+        tune = self.catalog.get_tune(tune_id)
+        if not tune:
+            msg = f"Track {prov_track_id} not found"
+            raise MediaNotFoundError(msg)
+        return self._tune_to_track(tune, subtune=subtune)
+
+    async def get_stream_details(
+        self, item_id: str, media_type: MediaType
+    ) -> StreamDetails:
+        """Resolve stream details for a SID track."""
+        parts = item_id.split("#")
+        tune_id = parts[0]
+        subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+
+        tune = self.catalog.get_tune(tune_id)
+        duration = self._default_track_duration()
+        if tune and tune.durations and subtune <= len(tune.durations):
+            duration = tune.durations[subtune - 1]
+
+        # Prefer a local HVSC copy when configured; otherwise render the mirrored SID.
+        local_file = self.audio_engine.resolve_local_sid_path(tune_id)
+        sid_path = (
+            str(local_file) if local_file else self.audio_engine.build_sid_url(tune_id)
+        )
+        return StreamDetails(
+            provider=self.domain,
+            item_id=item_id,
+            audio_format=AudioFormat(
+                content_type=ContentType.WAV,
+                sample_rate=self.audio_engine.sample_rate,
+                bit_depth=16,
+                channels=2,
+            ),
+            media_type=MediaType.TRACK,
+            stream_type=StreamType.CUSTOM,
+            duration=duration,
+            path=sid_path,
+        )
+
+    async def get_audio_stream(
+        self,
+        streamdetails: StreamDetails,
+        seek_position: int = 0,
+    ) -> AsyncGenerator[bytes]:
+        """Stream audio bytes when stream_type is StreamType.CUSTOM."""
+        # Local SID paths render directly; mirror URLs fetch the SID before rendering.
+        if (
+            streamdetails.path
+            and streamdetails.audio_format.content_type == ContentType.WAV
+        ):
+            parts = streamdetails.item_id.split("#")
+            subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+            duration = streamdetails.duration or self._default_track_duration()
+            if streamdetails.path.startswith(("http://", "https://")):
+                async for chunk in self.audio_engine.stream_hvsc_audio(
+                    streamdetails.item_id.split("#", 1)[0], subtune, duration
+                ):
+                    yield chunk
+            else:
+                async for chunk in self.audio_engine.stream_emulator_audio(
+                    sid_file_path=streamdetails.path,
+                    subtune=subtune,
+                    duration_seconds=duration,
+                ):
+                    yield chunk
+
+    def _composer_to_artist(self, composer: Composer) -> Artist:
+        """Convert Composer model to Music Assistant Artist."""
+        return Artist(
+            item_id=composer.item_id,
+            provider=self.domain,
+            name=composer.name,
+            provider_mappings={
+                ProviderMapping(
+                    item_id=composer.item_id,
+                    provider_domain=self.domain,
+                    provider_instance=self.instance_id,
+                )
+            },
+        )
+
+    def _composer_to_browse_folder(self, composer: Composer) -> BrowseFolder:
+        """Convert Composer model to a navigable BrowseFolder."""
+        return BrowseFolder(
+            item_id=f"musician/{composer.item_id}",
+            provider=self.instance_id,
+            path=self._browse_uri(f"musician/{composer.item_id}"),
+            name=composer.name,
+        )
+
+    def _browse_uri(self, path: str) -> str:
+        """Build a Music Assistant provider browse URI for a relative path."""
+        return f"{self.instance_id}://{path}"
+
+    def _tune_to_track(self, tune: Tune, subtune: int = 1) -> Track:
+        """Convert Tune model to Music Assistant Track."""
+        track_id = f"{tune.item_id}#{subtune}"
+        title = tune.title
+        if tune.subtunes_count > 1:
+            title = f"{tune.title} (Subtune {subtune})"
+
+        duration = self._default_track_duration()
+        if tune.durations and subtune <= len(tune.durations):
+            duration = tune.durations[subtune - 1]
+
+        artist = ItemMapping(
+            item_id=tune.composer_id,
+            provider=self.domain,
+            name=tune.composer_name,
+            media_type=MediaType.ARTIST,
+        )
+
+        return Track(
+            item_id=track_id,
+            provider=self.domain,
+            name=title,
+            duration=duration,
+            artists=UniqueList([artist]),
+            track_number=subtune,
+            provider_mappings={
+                ProviderMapping(
+                    item_id=track_id,
+                    provider_domain=self.domain,
+                    provider_instance=self.instance_id,
+                )
+            },
+        )
+
+    def _default_track_duration(self) -> int:
+        """Return the configured fallback playback limit for untimed tunes."""
+        value = self._get_config_value(
+            CONF_DEFAULT_DURATION, DEFAULT_DURATION_SECONDS
+        )
+        try:
+            return max(30, min(1800, int(value)))
+        except (TypeError, ValueError):
+            return DEFAULT_DURATION_SECONDS
diff --git a/music_assistant/providers/hvsc/sid_parser.py b/music_assistant/providers/hvsc/sid_parser.py
new file mode 100644
index 0000000..ebe8438
--- /dev/null
+++ b/music_assistant/providers/hvsc/sid_parser.py
@@ -0,0 +1,156 @@
+"""SID file binary header parser and HVSC Songlengths database parser."""
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+
+from .constants import DEFAULT_DURATION_SECONDS
+
+
+@dataclass
+class SidHeader:
+    """Parsed Commodore 64 SID file header information."""
+
+    magic: str
+    version: int
+    data_offset: int
+    load_address: int
+    init_address: int
+    play_address: int
+    songs: int
+    start_song: int
+    speed: int
+    title: str
+    author: str
+    released: str
+    flags: int = 0
+    sid_model: str = "MOS6581"
+    clock: str = "PAL"
+
+
+def _clean_str(raw: bytes) -> str:
+    """Decode raw bytes using ISO-8859-1 and strip null terminators / whitespace."""
+    null_idx = raw.find(b"\x00")
+    if null_idx != -1:
+        raw = raw[:null_idx]
+    return raw.decode("iso-8859-1", errors="replace").strip()
+
+
+def parse_sid_header(data: bytes) -> SidHeader:
+    """Parse PSID or RSID binary header from raw file bytes.
+
+    Specification:
+    Bytes 0-3: Magic ID ('PSID' or 'RSID')
+    Bytes 4-5: Version (0x0001 - 0x0004)
+    Bytes 6-7: Data offset (0x0076 for v1, 0x007C for v2+)
+    Bytes 8-9: Load address
+    Bytes 10-11: Init address
+    Bytes 12-13: Play address
+    Bytes 14-15: Songs count (subtunes)
+    Bytes 16-17: Start song (1-indexed default subtune)
+    Bytes 18-21: Speed flags (32-bit big endian)
+    Bytes 22-53: Name / Title (32 bytes)
+    Bytes 54-85: Author / Composer (32 bytes)
+    Bytes 86-117: Released / Copyright (32 bytes)
+    Bytes 118-119: Flags (v2+)
+    """
+    if len(data) < 0x0076:
+        msg = f"Data too short for SID header ({len(data)} bytes, minimum 118 bytes)"
+        raise ValueError(msg)
+
+    magic = data[0:4]
+    if magic not in (b"PSID", b"RSID"):
+        msg = f"Invalid SID magic identifier: {magic!r}, expected PSID or RSID"
+        raise ValueError(msg)
+
+    version, data_offset, load_addr, init_addr, play_addr, songs, start_song, speed = (
+        struct.unpack_from(">HHHHHHHI", data, 4)
+    )
+
+    title = _clean_str(data[22:54])
+    author = _clean_str(data[54:86])
+    released = _clean_str(data[86:118])
+
+    flags = 0
+    sid_model = "MOS6581"
+    clock = "PAL"
+
+    if version >= 2 and len(data) >= 0x0078:
+        (flags,) = struct.unpack_from(">H", data, 118)
+
+        # Clock bits 6-7: 01=PAL, 10=NTSC, 11=both
+        clock_bits = (flags >> 2) & 0x03
+        if clock_bits == 2:
+            clock = "NTSC"
+        elif clock_bits == 3:
+            clock = "PAL/NTSC"
+
+        # SID model bits 8-11: 01=MOS6581, 10=CSG8580, 11=both
+        sid_bits = (flags >> 4) & 0x03
+        if sid_bits == 2:
+            sid_model = "CSG8580"
+        elif sid_bits == 3:
+            sid_model = "MOS6581 / CSG8580"
+
+    return SidHeader(
+        magic=magic.decode("ascii"),
+        version=version,
+        data_offset=data_offset,
+        load_address=load_addr,
+        init_address=init_addr,
+        play_address=play_addr,
+        songs=max(1, songs),
+        start_song=max(1, start_song),
+        speed=speed,
+        title=title or "Unknown Title",
+        author=author or "Unknown Composer",
+        released=released or "Unknown",
+        flags=flags,
+        sid_model=sid_model,
+        clock=clock,
+    )
+
+
+def parse_duration_seconds(duration_str: str) -> int:
+    """Parse MM:SS or MM:SS.xxx into integer seconds."""
+    clean = duration_str.strip().split(".")[0]
+    parts = clean.split(":")
+    if len(parts) == 2:
+        try:
+            minutes = int(parts[0])
+            seconds = int(parts[1])
+            return minutes * 60 + seconds
+        except ValueError:
+            return DEFAULT_DURATION_SECONDS
+    elif len(parts) == 3:
+        try:
+            hours = int(parts[0])
+            minutes = int(parts[1])
+            seconds = int(parts[2])
+            return hours * 3600 + minutes * 60 + seconds
+        except ValueError:
+            return DEFAULT_DURATION_SECONDS
+    return DEFAULT_DURATION_SECONDS
+
+
+def parse_songlengths(content: str) -> dict[str, list[int]]:
+    """Parse HVSC Songlengths.txt / Songlengths.md5 database.
+
+    Lines format:
+    /MUSICIANS/H/Hubbard_Rob/Commando.sid=3:25 1:12 0:45
+    or MD5 hash format:
+    a1b2c3d4e5f6...=1:35 2:40 0:45
+    """
+    lengths_db: dict[str, list[int]] = {}
+    for line in content.splitlines():
+        line = line.strip()
+        if not line or line.startswith((";", "[")):
+            continue
+        if "=" in line:
+            key, times_str = line.split("=", 1)
+            key = key.strip()
+            times = [parse_duration_seconds(t) for t in times_str.strip().split() if t]
+            if times:
+                lengths_db[key] = times
+    return lengths_db
