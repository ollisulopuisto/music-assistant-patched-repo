From: Olli Sulopuisto <1051255+ollisulopuisto@users.noreply.github.com>
Date: Thu, 1 Oct 2026 15:15:00 +0300
Subject: [PATCH] Add High Voltage SID Collection (HVSC) music provider

Add native support for Commodore 64 SID chiptunes from the High Voltage
SID Collection (HVSC). Streams authentic hardware recordings (MOS 6581 R3 /
MOS 6581 R4 / CSG 8580 R5) from SOASC mirrors, supports optional local
emulation via sidplayfp, multi-subtune navigation, and catalog browsing
by composer, classic top 100 tunes, and games.
---
diff --git a/music_assistant/providers/hvsc/__init__.py b/music_assistant/providers/hvsc/__init__.py
new file mode 100644
index 0000000..c24a127
--- /dev/null
+++ b/music_assistant/providers/hvsc/__init__.py
@@ -0,0 +1,20 @@
+"""High Voltage SID Collection (HVSC) music provider for Music Assistant."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from .provider import HvscProvider
+
+if TYPE_CHECKING:
+    from music_assistant_models.config_entries import ProviderConfig
+    from music_assistant_models.provider import ProviderManifest
+
+
+async def setup(
+    mass: Any,
+    manifest: ProviderManifest,
+    config: ProviderConfig,
+) -> HvscProvider:
+    """Initialize HVSC provider with given configuration."""
+    return HvscProvider(mass, manifest, config)
diff --git a/music_assistant/providers/hvsc/audio_engine.py b/music_assistant/providers/hvsc/audio_engine.py
new file mode 100644
index 0000000..a407172
--- /dev/null
+++ b/music_assistant/providers/hvsc/audio_engine.py
@@ -0,0 +1,141 @@
+"""Audio streaming and emulation engine for HVSC tracks."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from collections.abc import AsyncGenerator
+from contextlib import suppress
+from pathlib import Path
+
+import aiohttp
+
+from .constants import (
+    DEFAULT_EMULATOR_CMD,
+    DEFAULT_SOASC_BASE_URL,
+    AudioSourceMode,
+    SidChipModel,
+)
+
+LOGGER = logging.getLogger(__name__)
+
+
+class AudioEngine:
+    """Handles audio stream generation from SOASC HTTP mirrors or local sidplayfp emulator."""
+
+    def __init__(
+        self,
+        base_url: str = DEFAULT_SOASC_BASE_URL,
+        chip_model: SidChipModel | str = SidChipModel.MOS6581R3,
+        audio_mode: AudioSourceMode | str = AudioSourceMode.ONLINE,
+        emulator_binary: str = DEFAULT_EMULATOR_CMD,
+        local_hvsc_path: str | None = None,
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        if isinstance(chip_model, str):
+            chip_model = SidChipModel(chip_model)
+        self.chip_model = chip_model
+
+        if isinstance(audio_mode, str):
+            audio_mode = AudioSourceMode(audio_mode)
+        self.audio_mode = audio_mode
+
+        self.emulator_binary = emulator_binary
+        self.local_hvsc_path = Path(local_hvsc_path) if local_hvsc_path else None
+
+    def build_soasc_url(self, hvsc_path: str, subtune: int = 1) -> str:
+        """Construct the direct SOASC MP3 URL for an HVSC track and subtune.
+
+        Naming convention on SOASC:
+        {category}/{subfolder}/{name}_T{subtune:03d}.sid_{chip_model}.mp3
+        Example:
+        MUSICIANS/H/Hubbard_Rob/Action_Biker_T001.sid_MOS6581R3.mp3
+        """
+        clean_path = hvsc_path.lstrip("/")
+        if clean_path.lower().endswith(".sid"):
+            clean_path = clean_path[:-4]
+
+        # Subtune is formatted as 3-digit padded number (e.g. T001, T002)
+        subtune_str = f"T{subtune:03d}"
+        filename = f"{clean_path}_{subtune_str}.sid_{self.chip_model.value}.mp3"
+        return f"{self.base_url}/{filename}"
+
+    def build_emulator_command(
+        self,
+        sid_file_path: str,
+        subtune: int = 1,
+        duration_seconds: int = 180,
+    ) -> list[str]:
+        """Build command line arguments to render SID to 16-bit 44.1kHz stereo WAV on stdout.
+
+        sidplayfp options:
+        -o<tune>: subtune number
+        -t<seconds>: song length in seconds
+        -w-: write WAV file to stdout
+        """
+        return [
+            self.emulator_binary,
+            f"-o{subtune}",
+            f"-t{duration_seconds}",
+            "-w-",
+            sid_file_path,
+        ]
+
+    def resolve_local_sid_path(self, hvsc_path: str) -> Path | None:
+        """Resolve an HVSC relative path against the configured local HVSC directory."""
+        if not self.local_hvsc_path or not self.local_hvsc_path.exists():
+            return None
+        candidate = self.local_hvsc_path / hvsc_path.lstrip("/")
+        if candidate.exists() and candidate.is_file():
+            return candidate
+        return None
+
+    async def stream_http_audio(
+        self,
+        url: str,
+        session: aiohttp.ClientSession | None = None,
+        chunk_size: int = 64 * 1024,
+    ) -> AsyncGenerator[bytes]:
+        """Stream audio bytes asynchronously from an HTTP URL."""
+        close_session = False
+        if session is None:
+            session = aiohttp.ClientSession()
+            close_session = True
+
+        try:
+            async with session.get(url) as response:
+                response.raise_for_status()
+                async for chunk in response.content.iter_chunked(chunk_size):
+                    yield chunk
+        finally:
+            if close_session:
+                await session.close()
+
+    async def stream_emulator_audio(
+        self,
+        sid_file_path: str,
+        subtune: int = 1,
+        duration_seconds: int = 180,
+        chunk_size: int = 64 * 1024,
+    ) -> AsyncGenerator[bytes]:
+        """Run sidplayfp subprocess and yield rendered audio bytes in real-time."""
+        cmd = self.build_emulator_command(sid_file_path, subtune, duration_seconds)
+        LOGGER.debug("Starting emulator rendering: %s", " ".join(cmd))
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.DEVNULL,
+        )
+
+        try:
+            assert proc.stdout is not None
+            while True:
+                data = await proc.stdout.read(chunk_size)
+                if not data:
+                    break
+                yield data
+        finally:
+            if proc.returncode is None:
+                proc.terminate()
+                with suppress(ProcessLookupError):
+                    await proc.wait()
