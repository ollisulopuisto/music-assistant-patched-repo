@@ -0,0 +1,455 @@
+"""Music Assistant Provider implementation for High Voltage SID Collection (HVSC)."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import AsyncGenerator, Sequence
+from typing import TYPE_CHECKING, Any
+
+from music_assistant_models.config_entries import (
+    ConfigEntry,
+    ConfigValueOption,
+    ConfigValueType,
+)
+from music_assistant_models.enums import (
+    ConfigEntryType,
+    ContentType,
+    MediaType,
+    ProviderFeature,
+    StreamType,
+)
+from music_assistant_models.errors import MediaNotFoundError
+from music_assistant_models.media_items import (
+    Artist,
+    AudioFormat,
+    BrowseFolder,
+    ItemMapping,
+    MediaItemType,
+    ProviderMapping,
+    SearchResults,
+    Track,
+    UniqueList,
+)
+from music_assistant_models.streamdetails import StreamDetails
+
+from .audio_engine import AudioEngine, AudioSourceMode, SidChipModel
+from .catalog import Composer, HvscCatalog, Tune
+from .constants import (
+    CONF_AUDIO_SOURCE,
+    CONF_DEFAULT_DURATION,
+    CONF_EMULATOR_CMD,
+    CONF_LOCAL_HVSC_PATH,
+    CONF_SID_CHIP,
+    CONF_SOASC_URL,
+    DEFAULT_DURATION_SECONDS,
+    DEFAULT_EMULATOR_CMD,
+    DEFAULT_SOASC_BASE_URL,
+)
+
+if TYPE_CHECKING:
+    from music_assistant_models.config_entries import ProviderConfig
+    from music_assistant_models.provider import ProviderManifest
+
+LOGGER = logging.getLogger(__name__)
+
+SUPPORTED_FEATURES = {
+    ProviderFeature.BROWSE,
+    ProviderFeature.SEARCH,
+    ProviderFeature.SIMILAR_TRACKS,
+}
+
+# Dynamic base class: inherit from real MusicProvider if inside Music Assistant,
+# else provide a standalone shim for unit testing and independent usage.
+try:
+    from music_assistant.models.music_provider import MusicProvider
+except ImportError:
+
+    class MusicProvider:  # type: ignore[no-redef]
+        """Shim for MusicProvider when running outside Music Assistant server."""
+
+        def __init__(
+            self,
+            mass: Any,
+            manifest: ProviderManifest,
+            config: ProviderConfig,
+            supported_features: set[ProviderFeature] | None = None,
+        ) -> None:
+            self.mass = mass
+            self.manifest = manifest
+            self.config = config
+            self.supported_features = supported_features or SUPPORTED_FEATURES
+            self.domain = manifest.domain
+            self.instance_id = config.instance_id
+
+
+class HvscProvider(MusicProvider):
+    """High Voltage SID Collection Music Provider for Music Assistant."""
+
+    def __init__(
+        self,
+        mass: Any,
+        manifest: ProviderManifest,
+        config: ProviderConfig,
+        supported_features: set[ProviderFeature] | None = None,
+    ) -> None:
+        super().__init__(mass, manifest, config, supported_features or SUPPORTED_FEATURES)
+        self.catalog = HvscCatalog()
+        self._init_audio_engine()
+
+    def _init_audio_engine(self) -> None:
+        """Initialize or update the audio engine using current configuration values."""
+        cfg_values = getattr(self.config, "values", {}) or {}
+        base_url = cfg_values.get(CONF_SOASC_URL, DEFAULT_SOASC_BASE_URL)
+        chip_model = cfg_values.get(CONF_SID_CHIP, SidChipModel.MOS6581R3.value)
+        audio_mode = cfg_values.get(CONF_AUDIO_SOURCE, AudioSourceMode.ONLINE.value)
+        emulator_cmd = cfg_values.get(CONF_EMULATOR_CMD, DEFAULT_EMULATOR_CMD)
+        local_path = cfg_values.get(CONF_LOCAL_HVSC_PATH, None)
+
+        self.audio_engine = AudioEngine(
+            base_url=base_url,
+            chip_model=chip_model,
+            audio_mode=audio_mode,
+            emulator_binary=emulator_cmd,
+            local_hvsc_path=local_path,
+        )
+
+    async def get_config_entries(
+        self,
+        action: str | None = None,
+        values: dict[str, ConfigValueType] | None = None,
+    ) -> tuple[ConfigEntry, ...]:
+        """Return configuration entries exposed to the Music Assistant settings UI."""
+        return (
+            ConfigEntry(
+                key=CONF_AUDIO_SOURCE,
+                type=ConfigEntryType.STRING,
+                label="Audio Playback Source",
+                default_value=AudioSourceMode.ONLINE.value,
+                options=[
+                    ConfigValueOption(
+                        AudioSourceMode.ONLINE.value,
+                        "Online Stream (Authentic C64 hardware recordings from SOASC)",
+                    ),
+                    ConfigValueOption(
+                        AudioSourceMode.LOCAL_EMULATOR.value,
+                        "Local Emulator (Render local .sid files via sidplayfp)",
+                    ),
+                    ConfigValueOption(
+                        AudioSourceMode.AUTO.value,
+                        "Auto (Use local emulator if present, fallback to online stream)",
+                    ),
+                ],
+                description="Select whether to stream pre-recorded authentic hardware audio or emulate locally.",
+            ),
+            ConfigEntry(
+                key=CONF_SID_CHIP,
+                type=ConfigEntryType.STRING,
+                label="Preferred SID Chip Model",
+                default_value=SidChipModel.MOS6581R3.value,
+                options=[
+                    ConfigValueOption(
+                        SidChipModel.MOS6581R3.value,
+                        "MOS 6581 R3 (Classic gritty 'breadbin' analog filter)",
+                    ),
+                    ConfigValueOption(
+                        SidChipModel.MOS6581R4.value,
+                        "MOS 6581 R4 (Later 6581 revision)",
+                    ),
+                    ConfigValueOption(
+                        SidChipModel.CSG8580R5.value,
+                        "CSG 8580 R5 (Clean, sharp C64C filter)",
+                    ),
+                ],
+                description="Choose the Commodore 64 SID chip revision for playback.",
+            ),
+
+            ConfigEntry(
+                key=CONF_SOASC_URL,
+                type=ConfigEntryType.STRING,
+                label="SOASC Mirror Base URL",
+                default_value=DEFAULT_SOASC_BASE_URL,
+                description="Base HTTP URL for Stone Oakvalley's Authentic SID Collection mirror.",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_LOCAL_HVSC_PATH,
+                type=ConfigEntryType.STRING,
+                label="Local HVSC Path",
+                default_value="",
+                description="Optional path to local C64Music directory (for local file playback).",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_EMULATOR_CMD,
+                type=ConfigEntryType.STRING,
+                label="Emulator Executable Command",
+                default_value=DEFAULT_EMULATOR_CMD,
+                description="Binary path or command for SID emulator (e.g. sidplayfp).",
+                advanced=True,
+            ),
+            ConfigEntry(
+                key=CONF_DEFAULT_DURATION,
+                type=ConfigEntryType.INTEGER,
+                label="Default Track Duration (seconds)",
+                default_value=DEFAULT_DURATION_SECONDS,
+                description="Fallback duration in seconds for subtunes when song length is not specified.",
+                advanced=True,
+            ),
+        )
+
+    async def handle_async_init(self) -> None:
+        """Handle asynchronous initialization when loaded into Music Assistant."""
+        self._init_audio_engine()
+        LOGGER.info("High Voltage SID Collection provider initialized successfully.")
+
+    async def search(
+        self,
+        search_query: str,
+        media_types: list[MediaType],
+        limit: int = 10,
+    ) -> SearchResults:
+        """Search HVSC for composers and tracks matching the search query."""
+        results = self.catalog.search(search_query)
+        artists: list[Artist] = []
+        tracks: list[Track] = []
+
+        if MediaType.ARTIST in media_types:
+            for composer in results["artists"][:limit]:
+                artists.append(self._composer_to_artist(composer))
+
+        if MediaType.TRACK in media_types:
+            for tune in results["tracks"][:limit]:
+                # Add default subtune as track
+                tracks.append(self._tune_to_track(tune, subtune=tune.default_subtune))
+
+        return SearchResults(
+            artists=artists,
+            tracks=tracks,
+        )
+
+    async def browse(self, path: str) -> Sequence[MediaItemType | ItemMapping | BrowseFolder]:
+        """Browse HVSC directory structure."""
+        clean_path = path.strip("/") if path else ""
+
+        # Root browsing
+        if not clean_path:
+            folders = self.catalog.browse_root()
+            return [
+                BrowseFolder(
+                    item_id=f.item_id,
+                    provider=self.domain,
+                    path=f.item_id,
+                    name=f.name,
+                )
+                for f in folders
+            ]
+
+        # Top 100 / Classic tunes
+        if clean_path == "top100":
+            return [
+                self._tune_to_track(tune, subtune=tune.default_subtune)
+                for tune in self.catalog.get_top_tunes()
+            ]
+
+        # Featured composers
+        if clean_path == "featured":
+            return [
+                self._composer_to_browse_folder(composer)
+                for composer in self.catalog.get_featured_composers()
+            ]
+
+        # Musicians A-Z root
+        if clean_path == "musicians":
+            letters = [chr(c) for c in range(ord("A"), ord("Z") + 1)]
+            return [
+                BrowseFolder(
+                    item_id=f"musicians/{letter}",
+                    provider=self.domain,
+                    path=f"musicians/{letter}",
+                    name=f"Musicians: {letter}",
+                )
+                for letter in letters
+            ]
+
+        # Musicians letter (e.g. "musicians/H")
+        if clean_path.startswith("musicians/"):
+            letter = clean_path.split("/")[-1]
+            composers = self.catalog.browse_musicians_letter(letter)
+            return [self._composer_to_browse_folder(c) for c in composers]
+
+        # Composer folder (e.g. "musician/Hubbard_Rob")
+        if clean_path.startswith("musician/"):
+            composer_id = clean_path.split("/", 1)[1]
+            tunes = self.catalog.get_tunes_by_composer(composer_id)
+            track_items: list[Track] = []
+            for tune in tunes:
+                for subtune in range(1, tune.subtunes_count + 1):
+                    track_items.append(self._tune_to_track(tune, subtune=subtune))
+            return track_items
+
+        # Games category
+        if clean_path == "games":
+            return [
+                self._tune_to_track(tune, subtune=tune.default_subtune)
+                for tune in self.catalog.get_top_tunes()
+            ]
+
+        return []
+
+    async def get_artist(self, prov_artist_id: str) -> Artist:
+        """Get composer artist details."""
+        composer = self.catalog.get_composer(prov_artist_id)
+        if not composer:
+            msg = f"Composer {prov_artist_id} not found"
+            raise MediaNotFoundError(msg)
+        return self._composer_to_artist(composer)
+
+    async def get_artist_tracks(self, prov_artist_id: str) -> list[Track]:
+        """Get all tracks composed by this artist."""
+        tunes = self.catalog.get_tunes_by_composer(prov_artist_id)
+        tracks: list[Track] = []
+        for tune in tunes:
+            for s in range(1, tune.subtunes_count + 1):
+                tracks.append(self._tune_to_track(tune, subtune=s))
+        return tracks
+
+    async def get_track(self, prov_track_id: str) -> Track:
+        """Get track metadata from item ID."""
+        # Item ID format: <hvsc_path>#<subtune>
+        parts = prov_track_id.split("#")
+        tune_id = parts[0]
+        subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+
+        tune = self.catalog.get_tune(tune_id)
+        if not tune:
+            msg = f"Track {prov_track_id} not found"
+            raise MediaNotFoundError(msg)
+        return self._tune_to_track(tune, subtune=subtune)
+
+    async def get_stream_details(self, item_id: str, media_type: MediaType) -> StreamDetails:
+        """Resolve stream details for a SID track."""
+        parts = item_id.split("#")
+        tune_id = parts[0]
+        subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+
+        tune = self.catalog.get_tune(tune_id)
+        duration = DEFAULT_DURATION_SECONDS
+        if tune and tune.durations and subtune <= len(tune.durations):
+            duration = tune.durations[subtune - 1]
+
+        # Check if local emulator playback is enabled and file exists
+        local_file = self.audio_engine.resolve_local_sid_path(tune_id)
+        if (
+            self.audio_engine.audio_mode in (AudioSourceMode.LOCAL_EMULATOR, AudioSourceMode.AUTO)
+            and local_file is not None
+        ):
+            return StreamDetails(
+                provider=self.domain,
+                item_id=item_id,
+                audio_format=AudioFormat(
+                    content_type=ContentType.WAV,
+                    sample_rate=44100,
+                    bit_depth=16,
+                    channels=2,
+                ),
+                media_type=MediaType.TRACK,
+                stream_type=StreamType.CUSTOM,
+                duration=duration,
+                path=str(local_file),
+            )
+
+        # Online SOASC stream (high quality authentic hardware MP3 recording)
+        stream_url = self.audio_engine.build_soasc_url(tune_id, subtune=subtune)
+        return StreamDetails(
+            provider=self.domain,
+            item_id=item_id,
+            audio_format=AudioFormat(
+                content_type=ContentType.MP3,
+                sample_rate=44100,
+                bit_rate=256,
+                channels=2,
+            ),
+            media_type=MediaType.TRACK,
+            stream_type=StreamType.HTTP,
+            duration=duration,
+            path=stream_url,
+        )
+
+    async def get_audio_stream(
+        self,
+        streamdetails: StreamDetails,
+        seek_position: int = 0,
+    ) -> AsyncGenerator[bytes]:
+        """Stream audio bytes when stream_type is StreamType.CUSTOM."""
+        # Check if local emulator file path is set
+        if streamdetails.path and streamdetails.audio_format.content_type == ContentType.WAV:
+            parts = streamdetails.item_id.split("#")
+            subtune = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 1
+            duration = streamdetails.duration or DEFAULT_DURATION_SECONDS
+            async for chunk in self.audio_engine.stream_emulator_audio(
+                sid_file_path=streamdetails.path,
+                subtune=subtune,
+                duration_seconds=duration,
+            ):
+                yield chunk
+        elif streamdetails.path and streamdetails.path.startswith("http"):
+            async for chunk in self.audio_engine.stream_http_audio(streamdetails.path):
+                yield chunk
+
+    def _composer_to_artist(self, composer: Composer) -> Artist:
+        """Convert Composer model to Music Assistant Artist."""
+        return Artist(
+            item_id=composer.item_id,
+            provider=self.domain,
+            name=composer.name,
+            provider_mappings={
+                ProviderMapping(
+                    item_id=composer.item_id,
+                    provider_domain=self.domain,
+                    provider_instance=self.instance_id,
+                )
+            },
+        )
+
+    def _composer_to_browse_folder(self, composer: Composer) -> BrowseFolder:
+        """Convert Composer model to a navigable BrowseFolder."""
+        return BrowseFolder(
+            item_id=f"musician/{composer.item_id}",
+            provider=self.domain,
+            path=f"musician/{composer.item_id}",
+            name=composer.name,
+        )
+
+    def _tune_to_track(self, tune: Tune, subtune: int = 1) -> Track:
+        """Convert Tune model to Music Assistant Track."""
+        track_id = f"{tune.item_id}#{subtune}"
+        title = tune.title
+        if tune.subtunes_count > 1:
+            title = f"{tune.title} (Subtune {subtune})"
+
+        duration = DEFAULT_DURATION_SECONDS
+        if tune.durations and subtune <= len(tune.durations):
+            duration = tune.durations[subtune - 1]
+
+        artist = ItemMapping(
+            item_id=tune.composer_id,
+            provider=self.domain,
+            name=tune.composer_name,
+            media_type=MediaType.ARTIST,
+        )
+
+        return Track(
+            item_id=track_id,
+            provider=self.domain,
+            name=title,
+            duration=duration,
+            artists=UniqueList([artist]),
+            track_number=subtune,
+            provider_mappings={
+                ProviderMapping(
+                    item_id=track_id,
+                    provider_domain=self.domain,
+                    provider_instance=self.instance_id,
+                )
+            },
+        )
