From: Olli Sulopuisto <1051255+ollisulopuisto@users.noreply.github.com>
Subject: [PATCH] Add HVSC SID rendering provider with stereo widening

Add browsing for HVSC tracks and render the actual SID files with
sidplayfp SIDLite. Include configurable stereo widening for playback.

---
diff --git a/music_assistant/providers/hvsc/__init__.py b/music_assistant/providers/hvsc/__init__.py
new file mode 100644
index 0000000..c24a127
--- /dev/null
+++ b/music_assistant/providers/hvsc/__init__.py
@@ -0,0 +1,20 @@
+"""High Voltage SID Collection (HVSC) music provider for Music Assistant."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from .provider import HvscProvider
+
+if TYPE_CHECKING:
+    from music_assistant_models.config_entries import ProviderConfig
+    from music_assistant_models.provider import ProviderManifest
+
+
+async def setup(
+    mass: Any,
+    manifest: ProviderManifest,
+    config: ProviderConfig,
+) -> HvscProvider:
+    """Initialize HVSC provider with given configuration."""
+    return HvscProvider(mass, manifest, config)
diff --git a/music_assistant/providers/hvsc/audio_engine.py b/music_assistant/providers/hvsc/audio_engine.py
new file mode 100644
index 0000000..8c6c2ee
--- /dev/null
+++ b/music_assistant/providers/hvsc/audio_engine.py
@@ -0,0 +1,231 @@
+"""Fetch HVSC SID files and render them with the sidplayfp emulator."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import tempfile
+import wave
+from collections.abc import AsyncGenerator
+from contextlib import suppress
+from pathlib import Path
+from typing import Any
+from urllib.parse import quote
+
+import aiohttp
+
+from .constants import (
+    DEFAULT_EMULATOR_CMD,
+    DEFAULT_FADE_OUT_SECONDS,
+    DEFAULT_HVSC_BASE_URL,
+    DEFAULT_SAMPLE_RATE,
+    DEFAULT_STEREO_WIDTH,
+    SidChipModel,
+)
+from .stereo import fade_wav_stream, widen_wav_stream
+
+LOGGER = logging.getLogger(__name__)
+
+
+class AudioEngine:
+    """Render catalog SID files locally with sidplayfp, optionally widening stereo."""
+
+    def __init__(
+        self,
+        base_url: Any = DEFAULT_HVSC_BASE_URL,
+        chip_model: Any = SidChipModel.MOS6581R3,
+        emulator_binary: Any = DEFAULT_EMULATOR_CMD,
+        local_hvsc_path: Any = None,
+        stereo_width: Any = DEFAULT_STEREO_WIDTH,
+        sample_rate: Any = DEFAULT_SAMPLE_RATE,
+        fade_out_seconds: Any = DEFAULT_FADE_OUT_SECONDS,
+    ) -> None:
+        if hasattr(base_url, "value"):
+            base_url = base_url.value or getattr(
+                base_url, "default_value", DEFAULT_HVSC_BASE_URL
+            )
+        self.base_url = str(base_url or DEFAULT_HVSC_BASE_URL).rstrip("/")
+        if hasattr(chip_model, "value"):
+            chip_model = chip_model.value or getattr(
+                chip_model, "default_value", SidChipModel.MOS6581R3.value
+            )
+        self.chip_model = (
+            SidChipModel(chip_model) if isinstance(chip_model, str) else chip_model
+        )
+        if hasattr(emulator_binary, "value"):
+            emulator_binary = emulator_binary.value or getattr(
+                emulator_binary, "default_value", DEFAULT_EMULATOR_CMD
+            )
+        self.emulator_binary = str(emulator_binary or DEFAULT_EMULATOR_CMD)
+        if hasattr(local_hvsc_path, "value"):
+            local_hvsc_path = local_hvsc_path.value or getattr(
+                local_hvsc_path, "default_value", None
+            )
+        self.local_hvsc_path = Path(local_hvsc_path) if local_hvsc_path else None
+        if hasattr(stereo_width, "value"):
+            stereo_width = stereo_width.value or getattr(
+                stereo_width, "default_value", DEFAULT_STEREO_WIDTH
+            )
+        try:
+            self.stereo_width = max(0, min(100, int(stereo_width)))
+        except (TypeError, ValueError):
+            self.stereo_width = DEFAULT_STEREO_WIDTH
+        if hasattr(sample_rate, "value"):
+            sample_rate = sample_rate.value or getattr(
+                sample_rate, "default_value", DEFAULT_SAMPLE_RATE
+            )
+        try:
+            self.sample_rate = max(8000, int(sample_rate))
+        except (TypeError, ValueError):
+            self.sample_rate = DEFAULT_SAMPLE_RATE
+        try:
+            if hasattr(fade_out_seconds, "value"):
+                fade_out_seconds = (
+                    fade_out_seconds.value
+                    if fade_out_seconds.value is not None
+                    else getattr(
+                        fade_out_seconds, "default_value", DEFAULT_FADE_OUT_SECONDS
+                    )
+                )
+            self.fade_out_seconds = max(0, min(30, int(fade_out_seconds)))
+        except (TypeError, ValueError):
+            self.fade_out_seconds = DEFAULT_FADE_OUT_SECONDS
+
+    def build_sid_url(self, hvsc_path: str) -> str:
+        """Build a safely escaped URL for the actual SID file in the HVSC mirror."""
+        clean_path = hvsc_path.lstrip("/")
+        if not clean_path.lower().endswith(".sid") or ".." in clean_path.split("/"):
+            raise ValueError(f"Invalid HVSC SID path: {hvsc_path}")
+        return f"{self.base_url}/{quote(clean_path, safe='/')}"
+
+    def build_emulator_command(
+        self,
+        sid_file_path: str,
+        wav_file_path: str,
+        subtune: int = 1,
+        duration_seconds: int = 180,
+    ) -> list[str]:
+        """Build a sidplayfp command that writes WAV to the requested file."""
+        if subtune < 1 or duration_seconds < 1:
+            raise ValueError("Subtune and duration must be positive")
+        model_flag = (
+            "-mof"
+            if self.chip_model in (SidChipModel.MOS6581R3, SidChipModel.MOS6581R4)
+            else "-mnf"
+        )
+        return [
+            self.emulator_binary,
+            "--sidlite",
+            model_flag,
+            "-s",
+            f"-f{self.sample_rate}",
+            "-p16",
+            f"-o{subtune}",
+            f"-t{duration_seconds}",
+            f"-w{wav_file_path}",
+            sid_file_path,
+        ]
+
+    def resolve_local_sid_path(self, hvsc_path: str) -> Path | None:
+        """Resolve an HVSC relative path against the configured local HVSC directory."""
+        if not self.local_hvsc_path or not self.local_hvsc_path.exists():
+            return None
+        relative_path = Path(hvsc_path)
+        if relative_path.is_absolute() or ".." in relative_path.parts:
+            return None
+        root = self.local_hvsc_path.resolve()
+        candidate = (root / relative_path).resolve()
+        if not candidate.is_relative_to(root):
+            return None
+        return candidate if candidate.is_file() else None
+
+    async def fetch_sid(
+        self, hvsc_path: str, session: aiohttp.ClientSession | None = None
+    ) -> bytes:
+        """Download one SID file from the configured HVSC mirror."""
+        close_session = session is None
+        session = session or aiohttp.ClientSession()
+        try:
+            async with session.get(self.build_sid_url(hvsc_path)) as response:
+                response.raise_for_status()
+                data = await response.read()
+                if len(data) < 4 or data[:4] not in (b"PSID", b"RSID"):
+                    raise ValueError(
+                        f"Mirror returned an invalid SID file for {hvsc_path}"
+                    )
+                if len(data) > 8 * 1024 * 1024:
+                    raise ValueError(f"SID file is unexpectedly large: {hvsc_path}")
+                return data
+        finally:
+            if close_session:
+                await session.close()
+
+    async def stream_emulator_audio(
+        self,
+        sid_file_path: str,
+        subtune: int = 1,
+        duration_seconds: int = 180,
+        chunk_size: int = 64 * 1024,
+    ) -> AsyncGenerator[bytes]:
+        """Render a SID to WAV with sidplayfp and stream its output file."""
+        with tempfile.TemporaryDirectory(prefix="hvsc-") as temp_dir:
+            wav_path = str(Path(temp_dir) / "render.wav")
+            cmd = self.build_emulator_command(
+                sid_file_path, wav_path, subtune, duration_seconds
+            )
+            LOGGER.debug("Rendering SID: %s", " ".join(cmd))
+            proc = await asyncio.create_subprocess_exec(
+                *cmd,
+                stdout=asyncio.subprocess.DEVNULL,
+                stderr=asyncio.subprocess.PIPE,
+            )
+            try:
+                _, stderr = await proc.communicate()
+                if proc.returncode:
+                    LOGGER.error(
+                        "sidplayfp failed (%s): %s",
+                        proc.returncode,
+                        (stderr or b"").decode(errors="replace"),
+                    )
+                    raise RuntimeError("sidplayfp could not render this SID file")
+                wav_file = Path(wav_path)
+                if not wav_file.is_file():
+                    raise RuntimeError("sidplayfp did not create its WAV output")
+
+                async def read_audio() -> AsyncGenerator[bytes]:
+                    rendered = await asyncio.to_thread(wav_file.open, "rb")
+                    try:
+                        while chunk := await asyncio.to_thread(
+                            rendered.read, chunk_size
+                        ):
+                            yield chunk
+                    finally:
+                        await asyncio.to_thread(rendered.close)
+
+                with wave.open(wav_path, "rb") as rendered:
+                    total_frames = rendered.getnframes()
+                widened = widen_wav_stream(read_audio(), self.stereo_width)
+                async for data in fade_wav_stream(
+                    widened, total_frames, self.fade_out_seconds
+                ):
+                    yield data
+            finally:
+                if proc.returncode is None:
+                    proc.terminate()
+                    with suppress(ProcessLookupError):
+                        await proc.wait()
+
+    async def stream_hvsc_audio(
+        self,
+        hvsc_path: str,
+        subtune: int = 1,
+        duration_seconds: int = 180,
+    ) -> AsyncGenerator[bytes]:
+        """Fetch the selected SID, then render it with sidplayfp."""
+        with tempfile.TemporaryDirectory(prefix="hvsc-sid-") as temp_dir:
+            sid_path = Path(temp_dir) / Path(hvsc_path).name
+            sid_path.write_bytes(await self.fetch_sid(hvsc_path))
+            async for chunk in self.stream_emulator_audio(
+                str(sid_path), subtune, duration_seconds
+            ):
+                yield chunk
