index 0000000..b8f5ead
--- /dev/null
+++ b/music_assistant/providers/hvsc/stereo.py
@@ -0,0 +1,163 @@
+"""Streaming stereo widening for PCM WAV emulator output."""
+
+from __future__ import annotations
+
+import math
+import struct
+from collections.abc import AsyncGenerator, AsyncIterable
+
+_FRAME_BYTES = 4  # 16-bit little-endian stereo PCM
+_WIDENING_HEADROOM = 0.66
+_MAX_SIDE_GAIN = 0.5
+_SIDE_DELAY_SECONDS = 0.008
+_HIGH_PASS_HZ = 150.0
+
+
+class _StereoWidener:
+    """Create a filtered, delayed side signal while preserving the dry center."""
+
+    def __init__(self, sample_rate: int, intensity: int) -> None:
+        amount = max(0, min(100, intensity)) / 100
+        self.side_gain = amount * _MAX_SIDE_GAIN
+        self.delay = [0.0] * max(1, round(sample_rate * _SIDE_DELAY_SECONDS))
+        self.delay_position = 0
+        self.dry_gain = _WIDENING_HEADROOM
+
+        omega = 2 * math.pi * min(_HIGH_PASS_HZ, sample_rate * 0.45) / sample_rate
+        cosine = math.cos(omega)
+        alpha = math.sin(omega) / math.sqrt(2)
+        a0 = 1 + alpha
+        self.b0 = (1 + cosine) / (2 * a0)
+        self.b1 = -(1 + cosine) / a0
+        self.b2 = self.b0
+        self.a1 = -2 * cosine / a0
+        self.a2 = (1 - alpha) / a0
+        self.x1 = self.x2 = self.y1 = self.y2 = 0.0
+
+    def process(self, pcm: bytes) -> bytes:
+        """Process complete stereo PCM frames."""
+        output = bytearray(len(pcm))
+        for offset in range(0, len(pcm), _FRAME_BYTES):
+            left, right = struct.unpack_from("<hh", pcm, offset)
+            mid = (left + right) * 0.5 / 32768
+            filtered = (
+                self.b0 * mid
+                + self.b1 * self.x1
+                + self.b2 * self.x2
+                - self.a1 * self.y1
+                - self.a2 * self.y2
+            )
+            self.x2, self.x1 = self.x1, mid
+            self.y2, self.y1 = self.y1, filtered
+
+            delayed = self.delay[self.delay_position]
+            self.delay[self.delay_position] = filtered
+            self.delay_position = (self.delay_position + 1) % len(self.delay)
+            side = delayed * self.side_gain * 32768
+
+            out_left = left * self.dry_gain + side
+            out_right = right * self.dry_gain - side
+            peak = max(abs(out_left), abs(out_right))
+            if peak > 32767:
+                # Scale both channels together so clipping cannot break the mono sum.
+                scale = 32767 / peak
+                out_left *= scale
+                out_right *= scale
+            struct.pack_into(
+                "<hh",
+                output,
+                offset,
+                max(-32768, min(32767, round(out_left))),
+                max(-32768, min(32767, round(out_right))),
+            )
+        return bytes(output)
+
+
+def _wav_data_header(data: bytes) -> tuple[int, int, bool] | None:
+    """Return the PCM data offset, sample rate and support flag when available."""
+    if len(data) < 12:
+        return None
+    if data[:4] != b"RIFF" or data[8:12] != b"WAVE":
+        return 0, 0, False
+
+    position = 12
+    audio_format = channels = bits_per_sample = sample_rate = None
+    while len(data) >= position + 8:
+        chunk_id, chunk_size = struct.unpack_from("<4sI", data, position)
+        content_offset = position + 8
+        if chunk_id == b"fmt ":
+            if chunk_size < 16:
+                return 0, 0, False
+            if len(data) < content_offset + 16:
+                return None
+            audio_format, channels, sample_rate = struct.unpack_from("<HHI", data, content_offset)
+            bits_per_sample = struct.unpack_from("<H", data, content_offset + 14)[0]
+        elif chunk_id == b"data":
+            supported = (
+                audio_format == 1
+                and channels == 2
+                and bits_per_sample == 16
+                and sample_rate is not None
+                and sample_rate > 0
+            )
+            return content_offset, sample_rate or 0, supported
+
+        next_position = content_offset + chunk_size + (chunk_size & 1)
+        if len(data) < next_position:
+            return None
+        position = next_position
+    return None
+
+
+async def widen_wav_stream(
+    chunks: AsyncIterable[bytes], intensity: int
+) -> AsyncGenerator[bytes]:
+    """Widen a streamed 16-bit stereo PCM WAV without buffering the whole track.
+
+    WAV headers and unsupported audio formats pass through unchanged. An intensity
+    of zero is a bit-perfect pass-through.
+    """
+    amount = max(0, min(100, int(intensity)))
+    if amount == 0:
+        async for chunk in chunks:
+            yield chunk
+        return
+
+    pending = bytearray()
+    widener: _StereoWidener | None = None
+    passthrough = False
+    async for chunk in chunks:
+        if passthrough:
+            yield chunk
+            continue
+
+        if widener is None:
+            pending.extend(chunk)
+            header = _wav_data_header(pending)
+            if header is None:
+                continue
+            data_offset, sample_rate, supported = header
+            if data_offset == 0 or not supported:
+                yield bytes(pending)
+                pending.clear()
+                passthrough = True
+                continue
+
+            yield bytes(pending[:data_offset])
+            audio = bytes(pending[data_offset:])
+            pending.clear()
+            widener = _StereoWidener(sample_rate, amount)
+        else:
+            audio = bytes(pending) + chunk
+            pending.clear()
+
+        complete_length = len(audio) - (len(audio) % _FRAME_BYTES)
+        if complete_length:
+            yield widener.process(audio[:complete_length])
+        if complete_length < len(audio):
+            pending.extend(audio[complete_length:])
+
+    if pending:
+        # A conforming stereo PCM stream ends on a frame boundary. Preserve any
+        # truncated trailing bytes rather than dropping or inventing audio data.
+        yield bytes(pending)
