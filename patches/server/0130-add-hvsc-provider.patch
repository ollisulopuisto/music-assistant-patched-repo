+"""Constants for the High Voltage SID Collection (HVSC) provider."""
+
+from __future__ import annotations
+
+from enum import Enum
+
+DOMAIN = "hvsc"
+PROVIDER_NAME = "High Voltage SID Collection"
+PROVIDER_VERSION = "1.0.0"
+
+# Configuration Keys
+CONF_AUDIO_SOURCE = "audio_source"
+CONF_SID_CHIP = "sid_chip"
+CONF_SOASC_URL = "soasc_url"
+CONF_LOCAL_HVSC_PATH = "local_hvsc_path"
+CONF_EMULATOR_CMD = "emulator_cmd"
+CONF_DEFAULT_DURATION = "default_duration"
+
+# Defaults
+DEFAULT_SOASC_BASE_URL = "https://mirror.accum.se/mirror/media/Oakvalley/soasc/hvsc/049/MP3"
+DEFAULT_DURATION_SECONDS = 180
+DEFAULT_EMULATOR_CMD = "sidplayfp"
+
+
+class SidChipModel(str, Enum):
+    """Commodore 64 Sound Interface Device chip model."""
+
+    MOS6581R3 = "MOS6581R3"  # Gritty, warm, early C64 analog filter
+    MOS6581R4 = "MOS6581R4"  # Later 6581 revision
+    CSG8580R5 = "CSG8580R5"  # Clean, sharp C64C / C64-II filter
+
+
+class AudioSourceMode(str, Enum):
+    """Audio source playback mode."""
+
+    ONLINE = "online"  # Stream authentic C64 hardware recordings from SOASC
+    LOCAL_EMULATOR = "local_emulator"  # Render local .sid files via sidplayfp/vsid
+    AUTO = "auto"  # Use local files & emulator if found, else fall back to online streaming
