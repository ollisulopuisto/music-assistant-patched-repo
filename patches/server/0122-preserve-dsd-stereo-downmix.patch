diff --git a/music_assistant/controllers/streams/audio_buffer.py b/music_assistant/controllers/streams/audio_buffer.py
index 87c5f3b..f6478c9 100644
--- a/music_assistant/controllers/streams/audio_buffer.py
+++ b/music_assistant/controllers/streams/audio_buffer.py
@@ -89,6 +89,7 @@ class AudioBuffer:
         mode: BufferMode = BufferMode.SEEKABLE,
         ready_threshold: int = 1,
         is_realtime: bool = False,
+        preserve_dsd_downmix_gain: bool = False,
     ) -> None:
         """
         Initialize AudioBuffer.
@@ -98,9 +99,12 @@ class AudioBuffer:
         :param mode: Buffer mode (SEEKABLE for tracks, ROLLING for radio).
         :param ready_threshold: Seconds of audio to buffer before signaling ready.
         :param is_realtime: Whether the source hands its audio over at playback pace.
+        :param preserve_dsd_downmix_gain: Preserve the direct DSD-to-stereo gain when
+            this DSD source is buffered as multichannel float PCM.
         """
         self.pcm_format = pcm_format
         self.is_realtime = is_realtime
+        self.preserve_dsd_downmix_gain = preserve_dsd_downmix_gain
         configured_max_size = (
             RADIO_BUFFER_SIZE if mode == BufferMode.ROLLING else BUFFER_SIZE_MAP[buffer_size]
         )
@@ -318,6 +322,7 @@ class AudioBuffer:
             input_format=self.pcm_format,
             output_format=output_format,
             filter_params=filter_params,
+            preserve_dsd_downmix_gain=self.preserve_dsd_downmix_gain,
         ):
             yield chunk
 
@@ -878,6 +883,10 @@ def _new_buffer(
         mode,
         ready_threshold=ready_threshold,
         is_realtime=streamdetails.is_realtime,
+        preserve_dsd_downmix_gain=(
+            is_dsd_audio_format(arriving_audio_format(streamdetails))
+            and arriving_audio_format(streamdetails).channels > 2
+        ),
     )
     # align chunk numbering with the actual stream start position so that
     # get_raw_stream(seek_position_ms) requests the correct chunk number
@@ -917,14 +926,24 @@ def _buffer_pcm_format(streamdetails: StreamDetails) -> AudioFormat:
     """
     arriving = arriving_audio_format(streamdetails)
     sample_rate = preferred_pcm_sample_rate(arriving)
+    is_dsd = is_dsd_audio_format(arriving)
     bit_depth = arriving.bit_depth
-    if is_dsd_audio_format(arriving):
+    content_type = ContentType.from_bit_depth(bit_depth)
+    if is_dsd:
         # DSD is stored in packed one-bit bytes; the decoded buffer is 24-bit PCM.
         # FFmpeg exposes DSD64 at 352.8 kHz (one sample per byte); the selected
         # PCM target is 176.4 kHz to keep the buffer size practical.
-        bit_depth = 24
+        if arriving.channels > 2:
+            # Keep the decoder's float output for surround DSD. An integer buffer
+            # makes FFmpeg normalize the later stereo rematrix for clipping safety,
+            # unlike the original direct DSD-to-stereo path.
+            content_type = ContentType.PCM_F32LE
+            bit_depth = 32
+        else:
+            content_type = ContentType.PCM_S24LE
+            bit_depth = 24
     return AudioFormat(
-        content_type=ContentType.from_bit_depth(bit_depth),
+        content_type=content_type,
         sample_rate=sample_rate,
         bit_depth=bit_depth,
         channels=min(arriving.channels, 8),
