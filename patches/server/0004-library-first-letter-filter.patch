index 000000000..442ae437a
--- /dev/null
+++ b/tests/controllers/music/test_library_first_letter_filter.py
@@ -0,0 +1,172 @@
+"""
+Tests for the first-letter filter on library listings.
+
+A large library is unreachable by scrolling: the listing pages 50 items at a time, so
+getting to T means dozens of round-trips. ``starts_with`` keeps only the items filed
+under one letter. The interesting part is *which* name it files them under - it has to
+be the one the current ordering uses, or a letter would hide items the list puts
+elsewhere.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import patch
+from uuid import uuid4
+
+import pytest
+from music_assistant_models.media_items import Artist, ProviderMapping
+
+from music_assistant.controllers.music.media.base import FIRST_LETTER_OTHER
+from music_assistant.mass import MusicAssistant
+
+pytestmark = pytest.mark.asyncio
+
+# name -> sort_name, covering every way a name can land somewhere surprising
+SEEDED_ARTISTS: dict[str, str | None] = {
+    "The Beatles": "Beatles, The",
+    "Talk Talk": None,
+    "Tool": None,
+    "Ätna": None,
+    "Sigur Rós": None,
+    "1975": None,
+    "!!!": None,
+}
+
+
+def _mapping() -> ProviderMapping:
+    """Create a provider mapping with a unique provider item id."""
+    return ProviderMapping(
+        item_id=uuid4().hex,
+        provider_domain="prov_a",
+        provider_instance="prov_a_inst",
+        in_library=True,
+    )
+
+
+@pytest.fixture(scope="module")
+async def lettered_mass(music_mass_module: MusicAssistant) -> MusicAssistant:
+    """Return a database-only instance seeded with the artists above."""
+    for name, sort_name in SEEDED_ARTISTS.items():
+        await music_mass_module.music.artists.add_item_to_library(
+            Artist(
+                item_id="0",
+                provider="library",
+                name=name,
+                sort_name=sort_name,
+                provider_mappings={_mapping()},
+            )
+        )
+    return music_mass_module
+
+
+async def _names(mass: MusicAssistant, **kwargs: object) -> set[str]:
+    """Return the names of the library artists matching the given listing arguments."""
+    return {item.name for item in await mass.music.artists.library_items(**kwargs)}  # type: ignore[arg-type]
+
+
+async def test_letter_follows_the_sort_name(lettered_mass: MusicAssistant) -> None:
+    """Sorted by sort name, "The Beatles" is filed under B rather than T."""
+    assert "The Beatles" in await _names(lettered_mass, starts_with="b", order_by="sort_name")
+    assert "The Beatles" not in await _names(lettered_mass, starts_with="t", order_by="sort_name")
+
+
+async def test_letter_follows_the_plain_name(lettered_mass: MusicAssistant) -> None:
+    """Sorted by name, the same artist is filed under T, alongside the other Ts."""
+    assert await _names(lettered_mass, starts_with="t", order_by="name") == {
+        "The Beatles",
+        "Talk Talk",
+        "Tool",
+    }
+    assert "The Beatles" not in await _names(lettered_mass, starts_with="b", order_by="name")
+
+
+async def test_diacritics_are_folded(lettered_mass: MusicAssistant) -> None:
+    """A name is filed under the letter it reads as, not the codepoint it starts with."""
+    assert "Ätna" in await _names(lettered_mass, starts_with="a", order_by="name")
+    assert "Sigur Rós" in await _names(lettered_mass, starts_with="s", order_by="name")
+
+
+async def test_case_is_ignored(lettered_mass: MusicAssistant) -> None:
+    """The caller may send either case for the letter."""
+    assert await _names(lettered_mass, starts_with="T", order_by="name") == await _names(
+        lettered_mass, starts_with="t", order_by="name"
+    )
+
+
+async def test_other_bucket_holds_everything_unlettered(lettered_mass: MusicAssistant) -> None:
+    """Digits and names that reduce to nothing at all are reachable, and only there."""
+    assert await _names(lettered_mass, starts_with=FIRST_LETTER_OTHER, order_by="name") == {
+        "1975",
+        "!!!",
+    }
+
+
+async def test_every_item_lands_in_exactly_one_bucket(lettered_mass: MusicAssistant) -> None:
+    """The A-Z strip plus the other bucket partitions the library: nothing is unreachable."""
+    for order_by in ("name", "sort_name"):
+        seen: list[str] = []
+        for bucket in [FIRST_LETTER_OTHER, *"abcdefghijklmnopqrstuvwxyz"]:
+            seen.extend(await _names(lettered_mass, starts_with=bucket, order_by=order_by))
+        assert sorted(seen) == sorted(SEEDED_ARTISTS)
+
+
+async def test_composes_with_the_other_filters(lettered_mass: MusicAssistant) -> None:
+    """A letter narrows the same result set the other filters do, rather than replacing it."""
+    assert await _names(
+        lettered_mass, starts_with="t", search="tool", order_by="name"
+    ) == {"Tool"}
+    assert not await _names(lettered_mass, starts_with="b", search="tool", order_by="name")
+
+
+@pytest.mark.parametrize("value", ["ab", "", "1", "$", "aa"])
+async def test_rejects_a_value_that_is_not_a_bucket(
+    lettered_mass: MusicAssistant, value: str
+) -> None:
+    """Anything that is not a single letter or the other bucket is refused, not ignored."""
+    if not value:
+        # an empty string is falsy and simply applies no filter, like the other filters
+        assert await _names(lettered_mass, starts_with=value) == set(SEEDED_ARTISTS)
+        return
+    with pytest.raises(ValueError, match="starts_with"):
+        await lettered_mass.music.artists.library_items(starts_with=value)
+
+
+async def test_the_filter_reads_the_index_rather_than_scanning(
+    lettered_mass: MusicAssistant,
+) -> None:
+    """
+    The point of a range over the name column is that SQLite can seek into the index.
+
+    A LIKE 'x%' would be correct too but leaves the planner free to scan the whole table,
+    which is the case this filter exists to avoid on a library with thousands of rows.
+    """
+    database = lettered_mass.music.database
+    controller = lettered_mass.music.artists
+    captured: dict[str, Any] = {}
+    orig = database.get_rows_from_query
