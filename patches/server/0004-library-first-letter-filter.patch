+    @final
+    def _starts_with_filter_clause(
+        self, starts_with: str, order_by: str | None, query_params: dict[str, Any]
+    ) -> str:
+        """
+        Return the SQL WHERE clause fragment that keeps one first-letter bucket.
+
+        :param starts_with: A single letter, or ``FIRST_LETTER_OTHER`` for the items filed
+            under no letter.
+        :param order_by: The ordering this query will use, which decides which name column
+            the bucket is matched against.
+        :param query_params: Query params dict; the clause's bound params are added to it.
+        :raises ValueError: If starts_with is neither a single ASCII letter nor
+            ``FIRST_LETTER_OTHER``.
+        """
+        # follow the ordering's own column, or a letter would hide items the list files
+        # elsewhere: sorted by sort name, "The Beatles" sits under B and not under T
+        name_column = "search_name" if order_by in ("name", "name_desc") else "search_sort_name"
+        column = f"{self.db_table}.{name_column}"
+        # expressed as a range rather than LIKE 'x%' so the index on the column is used
+        if starts_with == FIRST_LETTER_OTHER:
+            # 'a' is the upper bound here, not the lower one: everything below it
+            query_params["starts_with_hi"] = "a"
+            return f"{column} < :starts_with_hi"
+        letter = starts_with.lower()
+        if len(letter) != 1 or not ("a" <= letter <= "z"):
+            msg = f"starts_with must be a single letter or {FIRST_LETTER_OTHER!r}, got {starts_with!r}"
+            raise ValueError(msg)
+        query_params["starts_with_lo"] = letter
+        query_params["starts_with_hi"] = chr(ord(letter) + 1)
+        return f"({column} >= :starts_with_lo AND {column} < :starts_with_hi)"
+
     @final
     def _preprocess_search(self, search: str | None) -> str | None:
         """Normalize the search string for use in the search filter clauses."""
