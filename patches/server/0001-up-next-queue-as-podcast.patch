diff --git a/tests/providers/pocketcasts/test_pocketcasts.py b/tests/providers/pocketcasts/test_pocketcasts.py
index 5143c1f..1bafdf0 100644
--- a/tests/providers/pocketcasts/test_pocketcasts.py
+++ b/tests/providers/pocketcasts/test_pocketcasts.py
@@ -37,6 +37,8 @@ def provider(client: AsyncMock) -> PocketCastsProvider:
     config.get_value.return_value = None
     prov = PocketCastsProvider(mass, manifest, config)
     prov._client = client
+    # handle_async_init would set this up; it is skipped here since it also logs in
