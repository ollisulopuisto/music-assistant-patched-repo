new file mode 100644
index 0000000..868c964
--- /dev/null
+++ b/tests/helpers/test_playlist_items_cache.py
@@ -0,0 +1,142 @@
+"""Tests for the short-lived cache that serves a big playlist's pages from one read."""
+
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from music_assistant.helpers.playlist_items_cache import PlaylistItemsCache
+
+pytestmark = pytest.mark.asyncio
+
+
+class _Loader:
+    """Counts loads; optionally waits on an event so loads can overlap."""
+
+    def __init__(self, items: list[int], gate: asyncio.Event | None = None) -> None:
+        self.items = items
+        self.gate = gate
+        self.calls = 0
+
+    async def __call__(self) -> list[int]:
+        self.calls += 1
+        if self.gate is not None:
+            await self.gate.wait()
+        return list(self.items)
+
+
+class _Clock:
+    def __init__(self) -> None:
+        self.now = 0.0
+
+    def __call__(self) -> float:
+        return self.now
+
+
+async def test_second_read_comes_from_memory() -> None:
+    """Paging through a playlist reads the provider once, not once per page."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    load = _Loader([1, 2, 3])
+    assert await cache.items("pl", load, refresh=False) == [1, 2, 3]
+    assert await cache.items("pl", load, refresh=False) == [1, 2, 3]
+    assert load.calls == 1
+
+
+async def test_overlapping_reads_share_one_load() -> None:
+    """The count and the first page arrive together; they must share one provider read."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    gate = asyncio.Event()
+    load = _Loader([1, 2], gate)
+    first = asyncio.ensure_future(cache.items("pl", load, refresh=True))
+    second = asyncio.ensure_future(cache.items("pl", load, refresh=True))
+    await asyncio.sleep(0)
+    gate.set()
+    assert await first == [1, 2]
+    assert await second == [1, 2]
+    assert load.calls == 1
+
+
+async def test_refresh_reads_again() -> None:
+    """A refresh does not get the remembered copy."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    load = _Loader([1])
+    await cache.items("pl", load, refresh=False)
+    load.items = [1, 2]
+    assert await cache.items("pl", load, refresh=True) == [1, 2]
+    assert load.calls == 2
+
+
+async def test_entries_expire() -> None:
+    """After the time to live the playlist is read again, so edits elsewhere show up."""
+    clock = _Clock()
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache(ttl=60, clock=clock)
+    load = _Loader([1])
+    await cache.items("pl", load, refresh=False)
+    clock.now = 61
+    await cache.items("pl", load, refresh=False)
+    assert load.calls == 2
+
+
+async def test_only_a_few_playlists_are_kept() -> None:
+    """Memory stays bounded: the least recently used playlist is dropped."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache(max_entries=2)
+    loads = {key: _Loader([n]) for n, key in enumerate("abc")}
+    for key in "abc":
+        await cache.items(key, loads[key], refresh=False)
+    await cache.items("a", loads["a"], refresh=False)
+    assert loads["a"].calls == 2
+    await cache.items("c", loads["c"], refresh=False)
+    assert loads["c"].calls == 1
+
+
+async def test_a_failed_load_is_not_remembered() -> None:
+    """An error reaches the caller, and the next read tries again."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+
+    async def broken() -> list[int]:
+        raise RuntimeError("provider down")
+
+    with pytest.raises(RuntimeError):
+        await cache.items("pl", broken, refresh=False)
+    assert await cache.items("pl", _Loader([5]), refresh=False) == [5]
+
+
+async def test_views_are_built_once_per_order() -> None:
+    """A sorted or filtered view is computed once and then sliced for every page."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    load = _Loader([3, 1, 2])
+    builds = 0
+
+    def build(items: list[int]) -> list[int]:
+        nonlocal builds
+        builds += 1
+        return sorted(items)
+
+    assert await cache.view("pl", load, False, ("name",), build) == [1, 2, 3]
+    assert await cache.view("pl", load, False, ("name",), build) == [1, 2, 3]
+    assert builds == 1
+
+
+async def test_clear_forgets_everything() -> None:
+    """An edit to a playlist clears what was remembered."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    load = _Loader([1])
+    await cache.items("pl", load, refresh=False)
+    cache.clear()
+    await cache.items("pl", load, refresh=False)
+    assert load.calls == 2
+
+
+async def test_a_cancelled_caller_does_not_cancel_the_shared_load() -> None:
+    """One client going away must not break the read another client is waiting for."""
+    cache: PlaylistItemsCache[int] = PlaylistItemsCache()
+    gate = asyncio.Event()
+    load = _Loader([7], gate)
+    first = asyncio.ensure_future(cache.items("pl", load, refresh=False))
+    second = asyncio.ensure_future(cache.items("pl", load, refresh=False))
+    await asyncio.sleep(0)
+    first.cancel()
+    gate.set()
+    assert await second == [7]
+    assert load.calls == 1
