@@ -0,0 +1,133 @@
+"""
+A short-lived, in-memory copy of a playlist's items, so a big playlist is read once per visit.
+
+Paging through a 5000-item playlist in pages of 50 would otherwise read (and deserialise) the
+whole playlist from the provider cache for every page, and the count that is requested with the
+first page would read it once more.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from collections import OrderedDict
+from collections.abc import Awaitable, Callable, Hashable
+from dataclasses import dataclass, field
+
+# how long a playlist's items are kept, in seconds; short, so edits made elsewhere show up soon
+DEFAULT_TTL = 90.0
+# how many playlists are kept at once; a client looks at one at a time
+DEFAULT_MAX_ENTRIES = 2
+# how many sorted or filtered views of one playlist are kept
+MAX_VIEWS = 8
+
+
+@dataclass
+class _Entry[T]:
+    items: list[T]
+    loaded_at: float
+    views: OrderedDict[Hashable, list[T]] = field(default_factory=OrderedDict)
+
+
+class PlaylistItemsCache[T]:
+    """Keep the items of the most recently read playlists for a short while."""
+
+    def __init__(
+        self,
+        ttl: float = DEFAULT_TTL,
+        max_entries: int = DEFAULT_MAX_ENTRIES,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        """
+        Initialize the cache.
+
+        :param ttl: Seconds an entry stays valid.
+        :param max_entries: Number of playlists kept at once.
+        :param clock: Monotonic time source.
+        """
+        self._ttl = ttl
+        self._max_entries = max_entries
+        self._clock = clock
+        self._entries: OrderedDict[Hashable, _Entry[T]] = OrderedDict()
+        # loads in progress, keyed by (playlist key, refresh) so overlapping requests share one
+        self._loading: dict[tuple[Hashable, bool], asyncio.Future[list[T]]] = {}
+
+    async def items(
+        self, key: Hashable, load: Callable[[], Awaitable[list[T]]], refresh: bool
+    ) -> list[T]:
+        """
+        Return the playlist's items, loading them if they are not kept or a refresh is asked.
+
+        :param key: Identifies the playlist.
+        :param load: Reads every item of the playlist.
+        :param refresh: Skip the kept copy (a refresh joins a refresh already in progress).
+        """
+        return (await self._entry(key, load, refresh)).items
+
+    async def view(
+        self,
+        key: Hashable,
+        load: Callable[[], Awaitable[list[T]]],
+        refresh: bool,
+        view_key: Hashable,
+        build: Callable[[list[T]], list[T]],
+    ) -> list[T]:
+        """
+        Return a sorted or filtered view of the playlist's items, building it once.
+
+        :param key: Identifies the playlist.
+        :param load: Reads every item of the playlist.
+        :param refresh: Skip the kept copy.
+        :param view_key: Identifies the view (order, search, letter bounds).
+        :param build: Makes the view from the items.
+        """
+        entry = await self._entry(key, load, refresh)
+        if (view := entry.views.get(view_key)) is not None:
+            entry.views.move_to_end(view_key)
+            return view
+        view = build(entry.items)
+        entry.views[view_key] = view
+        while len(entry.views) > MAX_VIEWS:
+            entry.views.popitem(last=False)
+        return view
+
+    def clear(self) -> None:
+        """Forget every kept playlist, after one of them was edited."""
+        self._entries.clear()
+
+    async def _entry(
+        self, key: Hashable, load: Callable[[], Awaitable[list[T]]], refresh: bool
+    ) -> _Entry[T]:
+        if not refresh and (entry := self._entries.get(key)) is not None:
+            if self._clock() - entry.loaded_at <= self._ttl:
+                self._entries.move_to_end(key)
+                return entry
+            del self._entries[key]
+        flight = (key, refresh)
+        future = self._loading.get(flight)
+        if future is None:
+            future = asyncio.ensure_future(self._load(key, load, flight))
+            self._loading[flight] = future
+        # shielded: one caller going away must not cancel the read the others wait for
+        await asyncio.shield(future)
+        entry = self._entries.get(key)
+        if entry is None:
+            # dropped between the load and here (a clear, or many other playlists)
+            entry = _Entry(future.result(), self._clock())
+        return entry
+
+    async def _load(
+        self,
+        key: Hashable,
+        load: Callable[[], Awaitable[list[T]]],
+        flight: tuple[Hashable, bool],
+    ) -> list[T]:
+        try:
+            items = await load()
+        finally:
+            self._loading.pop(flight, None)
+        self._entries[key] = _Entry(items, self._clock())
+        self._entries.move_to_end(key)
+        while len(self._entries) > self._max_entries:
+            self._entries.popitem(last=False)
+        return items
