+            analysis_format = _analysis_pcm_format(input_format)
+            if analysis_format.channels == input_format.channels:
+                async for chunk in _iter_input_chunks():
+                    await self._distribute_chunk(
+                        session_key, chunk, max_interval=CHUNK_HANG_GUARD_SECONDS
+                    )
+            else:
+                pcm_bytes_per_second = analysis_format.pcm_sample_size
+                pending = bytearray()
