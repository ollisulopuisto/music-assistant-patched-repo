diff --git a/music_assistant/helpers/audio.py b/music_assistant/helpers/audio.py
index ce3b5e5..96824f1 100644
--- a/music_assistant/helpers/audio.py
+++ b/music_assistant/helpers/audio.py
@@ -755,6 +755,25 @@ def arriving_audio_format(streamdetails: StreamDetails) -> AudioFormat:
     return streamdetails.decoded_audio_format or streamdetails.audio_format
 
 
+def is_dsd_audio_format(audio_format: AudioFormat) -> bool:
+    """Return whether an audio format carries DSD rather than PCM samples."""
+    return audio_format.content_type == ContentType.DSF or audio_format.codec_type in {
+        ContentType.DSD_LSBF,
+        ContentType.DSD_MSBF,
+        ContentType.DSD_LSBF_PLANAR,
+        ContentType.DSD_MSBF_PLANAR,
+    }
+
+
+def preferred_pcm_sample_rate(audio_format: AudioFormat) -> int:
+    """Return the selected PCM output rate for an audio format."""
+    if is_dsd_audio_format(audio_format):
+        # FFmpeg exposes packed DSD at one sample per byte. Choose half that rate
+        # as the PCM output target (176.4 kHz for DSD64), then resample in FFmpeg.
+        return max(44100, audio_format.sample_rate // 2)
+    return audio_format.sample_rate
+
+
