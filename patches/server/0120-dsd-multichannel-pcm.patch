diff --git a/music_assistant/helpers/ffmpeg.py b/music_assistant/helpers/ffmpeg.py
index c32ea53..4604342 100644
--- a/music_assistant/helpers/ffmpeg.py
+++ b/music_assistant/helpers/ffmpeg.py
@@ -771,6 +771,12 @@ def _get_channel_layout_name(channels: int) -> str | None:
         return "mono"
     if channels == 2:
         return "stereo"
+    if channels == 6:
+        # The shared PCM buffer carries samples but no channel-layout metadata. Use the
+        # side-surround 5.1 layout as the canonical six-channel order so a 5.1(side)
+        # source is not later reinterpreted as back-surround 5.1 when the raw buffer is
+        # read for player output. FFmpeg rematrixes a back-surround source to this order.
+        return "5.1(side)"
     # a wider count maps to several possible layouts (5.1 vs 5.1(side), 7.1 vs 7.1(wide), ...)
     # and a named layout wins over -ac, so naming the wrong one would make FFmpeg misread the
     # stream as that layout. Left unnamed, it derives the default for the count itself.
