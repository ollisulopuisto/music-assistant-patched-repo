diff --git a/music_assistant/helpers/sleep_boundary.py b/music_assistant/helpers/sleep_boundary.py
new file mode 100644
index 0000000..1c48369
--- /dev/null
+++ b/music_assistant/helpers/sleep_boundary.py
@@ -0,0 +1,132 @@
+"""Find the point where a sleep timer should stop: the end of a track, an album or a chapter."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+# modes that stop at a boundary in the queue instead of after a fixed delay
+MODE_TRACK_END = "track_end"
+MODE_ALBUM_END = "album_end"
+MODE_FIT = "fit"
+
+
+@dataclass(frozen=True)
+class SleepItem:
+    """What the sleep timer needs to know about one queue item."""
+
+    item_id: str
+    duration: float | None
+    album: str | None
+    # positions (seconds into the item) where a chapter ends, in order
+    chapter_ends: tuple[float, ...] = ()
+
+
+@dataclass(frozen=True)
+class SleepTarget:
+    """A point in the queue to stop at."""
+
+    item_id: str
+    position: float
+
+
+def sleep_item_from(queue_item: Any) -> SleepItem:
+    """
+    Build a SleepItem from a queue item.
+
+    :param queue_item: The queue item to describe.
+    """
+    media_item = queue_item.media_item
+    duration = float(queue_item.duration) if queue_item.duration else None
+    album_obj = getattr(media_item, "album", None)
+    album = getattr(album_obj, "uri", None) if album_obj else None
+    chapters = getattr(getattr(media_item, "metadata", None), "chapters", None) or []
+    ordered = sorted(chapters, key=lambda chapter: chapter.start)
+    ends: list[float] = []
+    for index, chapter in enumerate(ordered):
+        end = chapter.end
+        if not end and index + 1 < len(ordered):
+            end = ordered[index + 1].start
+        if not end:
+            end = duration
+        if end:
+            ends.append(float(end))
+    return SleepItem(queue_item.queue_item_id, duration, album, tuple(ends))
+
+
+def _boundaries(items: list[SleepItem], elapsed: float) -> list[tuple[str, float, float]]:
+    """
+    List every place playback could stop, as (item id, position, media seconds from now).
+
+    Stops at the first item whose length is unknown, since nothing after it can be timed.
+    """
+    found: list[tuple[str, float, float]] = []
+    before = 0.0  # media seconds from now up to the start of the current item
+    for index, item in enumerate(items):
+        if item.duration is None:
+            break
+        start = elapsed if index == 0 else 0.0
+        for position in (*item.chapter_ends, item.duration):
+            if position > start:
+                found.append((item.item_id, position, before + position - start))
+        before += item.duration - start
+    return found
+
+
+def pick_target(
+    mode: str, budget: float, items: list[SleepItem], elapsed: float, speed: float
+) -> SleepTarget | None:
+    """
+    Choose where to stop, or None when the mode finds no such place.
+
+    :param mode: track_end, album_end or fit.
+    :param budget: For fit, the wall-clock seconds the stop must come within.
+    :param items: The queue from the playing item onwards.
+    :param elapsed: Seconds played of the first item.
+    :param speed: Playback speed; media seconds pass this many times faster than the clock.
+    """
+    boundaries = _boundaries(items, elapsed)
+    if not boundaries or not items:
+        return None
+    if mode == MODE_TRACK_END:
+        item_id, position, _ = boundaries[0]
+        return SleepTarget(item_id, position)
+    if mode == MODE_ALBUM_END:
+        album = items[0].album
+        if album is None:
+            return None
+        last = None
+        for item in items:
+            if item.album != album or item.duration is None:
+                break
+            last = item
+        return SleepTarget(last.item_id, last.duration or 0.0) if last else None
+    if mode == MODE_FIT:
+        fitting = [b for b in boundaries if b[2] <= budget * speed]
+        if not fitting:
+            return None
+        item_id, position, _ = fitting[-1]
+        return SleepTarget(item_id, position)
+    return None
+
+
+def seconds_until(
+    target: SleepTarget, items: list[SleepItem], elapsed: float, speed: float
+) -> float | None:
+    """
+    Return the wall-clock seconds until the target is reached, or None if it cannot be timed.
+
+    :param target: The point to stop at.
+    :param items: The queue from the playing item onwards.
+    :param elapsed: Seconds played of the first item.
+    :param speed: Playback speed.
+    """
+    before = 0.0
+    for index, item in enumerate(items):
+        start = elapsed if index == 0 else 0.0
+        if item.item_id == target.item_id:
+            return max(0.0, before + target.position - start) / speed
+        if item.duration is None:
+            return None
+        before += item.duration - start
+    return None
