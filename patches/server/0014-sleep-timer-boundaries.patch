diff --git a/tests/helpers/test_sleep_boundary.py b/tests/helpers/test_sleep_boundary.py
new file mode 100644
index 0000000..1179803
--- /dev/null
+++ b/tests/helpers/test_sleep_boundary.py
@@ -0,0 +1,124 @@
+"""Tests for finding where a sleep timer should stop: at the end of a track, album or chapter."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from music_assistant.helpers.sleep_boundary import (
+    SleepItem,
+    SleepTarget,
+    pick_target,
+    seconds_until,
+    sleep_item_from,
+)
+
+
+def _tracks(*durations: float, album: str | None = "a") -> list[SleepItem]:
+    return [SleepItem(f"i{n}", d, album) for n, d in enumerate(durations)]
+
+
+def test_track_end_is_the_end_of_the_playing_track() -> None:
+    """Stopping at the end of this track means the end of the first item."""
+    items = _tracks(200, 180)
+    assert pick_target("track_end", 0, items, 50, 1.0) == SleepTarget("i0", 200)
+    assert seconds_until(SleepTarget("i0", 200), items, 50, 1.0) == 150
+
+
+def test_track_end_inside_a_book_is_the_end_of_the_chapter() -> None:
+    """An audiobook is one item; the end of the playing chapter is what counts."""
+    book = SleepItem("book", 36000, None, chapter_ends=(600, 1500, 2100))
+    assert pick_target("track_end", 0, [book], 700, 1.0) == SleepTarget("book", 1500)
+    assert seconds_until(SleepTarget("book", 1500), [book], 700, 1.0) == 800
+
+
+def test_album_end_is_the_end_of_the_last_track_of_the_same_album() -> None:
+    """The run stops where the queue leaves the album."""
+    items = [
+        SleepItem("t1", 100, "x"),
+        SleepItem("t2", 120, "x"),
+        SleepItem("t3", 140, "x"),
+        SleepItem("t4", 90, "y"),
+    ]
+    target = pick_target("album_end", 0, items, 40, 1.0)
+    assert target == SleepTarget("t3", 140)
+    assert seconds_until(target, items, 40, 1.0) == 60 + 120 + 140
+
+
+def test_album_end_needs_an_album() -> None:
+    """A radio stream or a book has no album to run to the end of."""
+    assert pick_target("album_end", 0, _tracks(100, album=None), 0, 1.0) is None
+
+
+def test_fit_takes_the_latest_track_end_inside_the_budget() -> None:
+    """Thirty minutes of four-minute tracks end after seven tracks, not at the thirty mark."""
+    items = _tracks(*[240] * 10)
+    target = pick_target("fit", 30 * 60, items, 0, 1.0)
+    assert target == SleepTarget("i6", 240)
+    assert seconds_until(target, items, 0, 1.0) == 7 * 240
+
+
+def test_fit_counts_only_what_is_left_of_the_playing_track() -> None:
+    """Time already played of the first track does not eat the budget."""
+    items = _tracks(240, 240, 240)
+    target = pick_target("fit", 500, items, 200, 1.0)
+    assert target == SleepTarget("i1", 240)
+
+
+def test_fit_stops_at_a_chapter_end_inside_a_book() -> None:
+    """With thirty minutes to spare, the book stops at the last chapter that ends in time."""
+    book = SleepItem("book", 36000, None, chapter_ends=(600, 1500, 2100, 3000))
+    target = pick_target("fit", 30 * 60, [book], 500, 1.0)
+    assert target == SleepTarget("book", 2100)
+    assert seconds_until(target, [book], 500, 1.0) == 1600
+
+
+def test_fit_gives_up_when_no_boundary_is_close_enough() -> None:
+    """A single chapter longer than the budget leaves nothing to land on."""
+    book = SleepItem("book", 36000, None, chapter_ends=(4000,))
+    assert pick_target("fit", 600, [book], 0, 1.0) is None
+
+
+def test_playback_speed_shortens_the_wait() -> None:
+    """At 2x, a chapter that has 600 seconds left ends in 300 seconds of wall time."""
+    book = SleepItem("book", 36000, None, chapter_ends=(1000,))
+    assert seconds_until(SleepTarget("book", 1000), [book], 400, 2.0) == 300
+    # and the budget buys twice the media
+    assert pick_target("fit", 300, [book], 400, 2.0) == SleepTarget("book", 1000)
+
+
+def test_a_target_that_has_gone_from_the_queue_is_unknown() -> None:
+    """A skipped or removed item cannot be waited for."""
+    assert seconds_until(SleepTarget("gone", 10), _tracks(100), 0, 1.0) is None
+
+
+def test_items_of_unknown_length_end_the_search() -> None:
+    """Nothing is known past a stream that has no duration."""
+    items = [SleepItem("t1", 100, "x"), SleepItem("t2", None, "x"), SleepItem("t3", 100, "x")]
+    assert pick_target("album_end", 0, items, 0, 1.0) == SleepTarget("t1", 100)
+
+
+def test_chapters_are_read_from_a_queue_item() -> None:
+    """Chapter ends come from the next chapter's start, or the item's duration for the last one."""
+    chapters = [
+        SimpleNamespace(start=0.0, end=None),
+        SimpleNamespace(start=600.0, end=1500.0),
+        SimpleNamespace(start=1500.0, end=None),
+    ]
+    queue_item = SimpleNamespace(
+        queue_item_id="book",
+        duration=2400,
+        media_item=SimpleNamespace(metadata=SimpleNamespace(chapters=chapters), album=None),
+    )
