+
+        controller.set_sleep_timer("player_1", 600, "fit")
+
+        assert mock_mass.call_later.call_args.args[0] == 600
+
+    def test_track_end_timer_needs_a_queue(self, mock_mass: MagicMock) -> None:
+        """Without anything playing there is no track to wait for."""
