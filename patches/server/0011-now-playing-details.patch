 music_assistant/helpers/now_playing.py        | 36 +++++++++++++++++
 tests/helpers/test_now_playing.py             | 39 +++++++++++++++++++
 3 files changed, 86 insertions(+)
 create mode 100644 music_assistant/helpers/now_playing.py
 create mode 100644 tests/helpers/test_now_playing.py

diff --git a/music_assistant/controllers/player_queues/controller.py b/music_assistant/controllers/player_queues/controller.py
