From 41b5c2010830093d1780900cbf5bfbcac221fb7c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 21:51:41 +0000
Subject: [PATCH] Read the decoded stream format from lighter stream records
 too

---
 music_assistant/helpers/audio.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/music_assistant/helpers/audio.py b/music_assistant/helpers/audio.py
index df00b6b09..f4e1c41dd 100644
--- a/music_assistant/helpers/audio.py
+++ b/music_assistant/helpers/audio.py
@@ -752,7 +752,10 @@ def arriving_audio_format(streamdetails: StreamDetails) -> AudioFormat:
 
     :param streamdetails: The stream the audio belongs to.
     """
-    return streamdetails.decoded_audio_format or streamdetails.audio_format
+    # getattr: a stream described by something lighter than a full StreamDetails (a test
+    # double, a plugin's own record) has no decoded format and is what it says it is
+    decoded = getattr(streamdetails, "decoded_audio_format", None)
+    return decoded or streamdetails.audio_format
 
 
 def pcm_container_bit_depth(bit_depth: int) -> int:
-- 
