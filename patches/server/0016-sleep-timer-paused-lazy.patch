+
+def _counted(items: list[SleepItem], pulled: list[int]) -> Iterator[SleepItem]:
+    for item in items:
+        pulled.append(1)
+        yield item
+
+
+def test_track_end_looks_only_at_the_playing_item() -> None:
+    """A long queue is not walked to find the end of the playing track."""
+    pulled: list[int] = []
+    items = _counted(_tracks(*[200] * 1000), pulled)
+    assert pick_target("track_end", 0, items, 0, 1.0) == SleepTarget("i0", 200)
+    assert len(pulled) == 1
+
+
+def test_fit_stops_reading_past_the_budget() -> None:
+    """Items beyond the time budget are not looked at."""
+    pulled: list[int] = []
+    items = _counted(_tracks(*[240] * 1000), pulled)
+    assert pick_target("fit", 30 * 60, items, 0, 1.0) == SleepTarget("i6", 240)
+    assert len(pulled) <= 9
+
+
+def test_album_end_stops_reading_where_the_album_ends() -> None:
+    """The queue is read only until it leaves the album."""
+    pulled: list[int] = []
+    items = _counted([*_tracks(100, 100), *_tracks(*[100] * 500, album="b")], pulled)
+    assert pick_target("album_end", 0, items, 0, 1.0) == SleepTarget("i1", 100)
+    assert len(pulled) == 3
