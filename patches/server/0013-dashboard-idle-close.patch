+++ b/tests/providers/chromecast/test_idle_dashboard_close.py
@@ -0,0 +1,102 @@
+"""
+Tests for closing a now-playing dashboard that has shown next to idle playback for too long.
+
+A Cast receiver keeps looping its keepalive media for as long as a dashboard is open, which
+wakes whatever is wired to the device. The closer ends the dashboard once playback has been
+idle for the configured time, and never while something is playing.
+"""
+
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from music_assistant.providers.chromecast.idle_close import IdleDashboardCloser
+
+pytestmark = pytest.mark.asyncio
+
+IDLE = 0.05
+
+
+def _closer(idle_seconds: float = IDLE) -> tuple[IdleDashboardCloser, list[str]]:
+    closed: list[str] = []
+
+    async def close(key: str) -> None:
+        closed.append(key)
+
+    return IdleDashboardCloser(asyncio.get_running_loop(), idle_seconds, close), closed
+
+
+async def test_a_dashboard_is_closed_once_playback_has_been_idle_long_enough() -> None:
+    """Idle for the whole period closes the dashboard."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    await asyncio.sleep(IDLE * 3)
+    assert closed == ["a"]
+
+
+async def test_playback_starting_cancels_the_pending_close() -> None:
+    """Something playing again before the period ends keeps the dashboard."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    await asyncio.sleep(IDLE / 3)
+    closer.observe("a", playing=True)
+    await asyncio.sleep(IDLE * 3)
+    assert closed == []
+
+
+async def test_repeated_idle_reports_do_not_restart_the_clock() -> None:
+    """The period counts from when playback went idle, not from the latest status."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    await asyncio.sleep(IDLE / 2)
+    closer.observe("a", playing=False)
+    await asyncio.sleep(IDLE * 0.8)
+    assert closed == ["a"]
+
+
+async def test_a_dashboard_is_closed_only_once() -> None:
+    """After the close fired, further idle reports do not queue another one for it."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    await asyncio.sleep(IDLE * 2)
+    assert closed == ["a"]
+    closer.forget("a")
+    await asyncio.sleep(IDLE * 2)
+    assert closed == ["a"]
+
+
+async def test_forgetting_a_dashboard_cancels_its_close() -> None:
+    """A dashboard that ended by itself needs no close."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    closer.forget("a")
+    await asyncio.sleep(IDLE * 3)
+    assert closed == []
+
+
+async def test_a_period_of_zero_never_closes_anything() -> None:
+    """Zero switches the feature off."""
+    closer, closed = _closer(0)
+    closer.observe("a", playing=False)
+    await asyncio.sleep(0.1)
+    assert closed == []
+
+
+async def test_devices_are_timed_separately() -> None:
+    """One device playing does not keep another's idle dashboard open."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    closer.observe("b", playing=True)
+    await asyncio.sleep(IDLE * 3)
+    assert closed == ["a"]
+
+
+async def test_stopping_the_closer_cancels_everything_pending() -> None:
+    """Unloading the provider must not leave timers behind."""
+    closer, closed = _closer()
+    closer.observe("a", playing=False)
+    closer.stop()
+    await asyncio.sleep(IDLE * 3)
+    assert closed == []
