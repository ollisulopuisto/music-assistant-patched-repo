@@ -0,0 +1,122 @@
+"""Tests for how the Chromecast dashboards feed idle playback to the idle closer."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+from uuid import uuid4
+
+import pytest
+from music_assistant_models.enums import DashboardType, PlaybackState
+
+from music_assistant.providers.chromecast.constants import MASS_APP_ID
+from music_assistant.providers.chromecast.dashboard import (
+    ChromecastDashboards,
+    _ActiveDashboardCast,
+)
+
+from .test_dashboard_liveness import _chromecast, _make_dashboards
+
+pytestmark = pytest.mark.asyncio
+
+
+def _dashboards_showing(
+    dashboard: DashboardType, state: PlaybackState
+) -> tuple[ChromecastDashboards, str, MagicMock]:
+    """Return dashboards with one device showing `dashboard` while its player is in `state`."""
+    dashboards = _make_dashboards()
+    device_id = str(uuid4())
+    dashboards._active_casts[device_id] = _ActiveDashboardCast(
+        cast_session_id="s", listener=MagicMock(), dashboard=dashboard
+    )
+    dashboards.mass.players.get_player.return_value = SimpleNamespace(playback_state=state)
+    closer = MagicMock()
+    dashboards._idle_closer = closer
+    return dashboards, device_id, closer
+
+
+async def test_idle_playback_under_a_now_playing_dashboard_starts_the_clock() -> None:
+    """A now-playing dashboard beside an idle player is reported as not playing."""
+    dashboards, device_id, closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.IDLE
+    )
+    dashboards._observe_idle(device_id)
+    closer.observe.assert_called_once_with(device_id, playing=False)
+
+
+async def test_playing_under_a_now_playing_dashboard_is_reported_as_playing() -> None:
+    """Something playing keeps the dashboard."""
+    dashboards, device_id, closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.PLAYING
+    )
+    dashboards._observe_idle(device_id)
+    closer.observe.assert_called_once_with(device_id, playing=True)
+
+
+async def test_a_party_dashboard_is_never_closed_for_idle_playback() -> None:
+    """Only a now-playing dashboard is tied to playback; a party screen stays up."""
+    dashboards, device_id, closer = _dashboards_showing(DashboardType.PARTY, PlaybackState.IDLE)
+    dashboards._observe_idle(device_id)
+    closer.observe.assert_not_called()
+
+
+async def test_a_player_event_for_another_device_is_ignored() -> None:
+    """Events for players with no dashboard do not reach the closer."""
+    dashboards, _device_id, closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.IDLE
+    )
+    dashboards._on_player_event(SimpleNamespace(object_id="some-other-player"))  # type: ignore[arg-type]
+    closer.observe.assert_not_called()
+
+
+async def test_closing_an_idle_dashboard_quits_the_receiver_then_ends_the_session() -> None:
+    """The receiver app is quit first, which stops the keepalive loop, then the session ends."""
+    dashboards, device_id, _closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.IDLE
+    )
+    chromecast = _chromecast(app_id=MASS_APP_ID)
+    chromecast.app_id = MASS_APP_ID
+    dashboards._dashboard_connections[device_id] = chromecast
+    calls: list[str] = []
+    chromecast.quit_app.side_effect = lambda: calls.append("quit")
+    dashboards.mass.dashboard.hide_dashboard = AsyncMock(  # type: ignore[method-assign]
+        side_effect=lambda _id: calls.append("hide")
+    )
+
+    await dashboards._close_idle(device_id)
+
+    assert calls == ["quit", "hide"]
+    dashboards.mass.dashboard.hide_dashboard.assert_awaited_once_with(f"chromecast_{device_id}")
+
+
+async def test_closing_does_not_quit_an_app_that_is_not_ours() -> None:
+    """If another app took over the device, only the session is ended."""
+    dashboards, device_id, _closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.IDLE
+    )
+    chromecast = _chromecast(app_id="SOMEOTHERAPP")
+    chromecast.app_id = "SOMEOTHERAPP"
+    dashboards._dashboard_connections[device_id] = chromecast
+    dashboards.mass.dashboard.hide_dashboard = AsyncMock()  # type: ignore[method-assign]
+
+    await dashboards._close_idle(device_id)
+
+    chromecast.quit_app.assert_not_called()
+    dashboards.mass.dashboard.hide_dashboard.assert_awaited_once()
+
+
+async def test_closing_a_dashboard_that_already_ended_does_nothing() -> None:
+    """A timer firing after the dashboard ended by itself changes nothing."""
+    dashboards = _make_dashboards()
+    dashboards.mass.dashboard.hide_dashboard = AsyncMock()  # type: ignore[method-assign]
+    await dashboards._close_idle(str(uuid4()))
+    dashboards.mass.dashboard.hide_dashboard.assert_not_awaited()
+
+
+async def test_ending_a_session_stops_timing_it() -> None:
+    """Dropping a dashboard cancels its idle timer."""
+    dashboards, device_id, closer = _dashboards_showing(
+        DashboardType.NOW_PLAYING, PlaybackState.IDLE
+    )
+    dashboards._drop_active_cast(device_id)
+    closer.forget.assert_called_once_with(device_id)
