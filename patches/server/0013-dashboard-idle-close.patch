diff --git a/music_assistant/providers/chromecast/idle_close.py b/music_assistant/providers/chromecast/idle_close.py
new file mode 100644
index 0000000..73bb228
--- /dev/null
+++ b/music_assistant/providers/chromecast/idle_close.py
@@ -0,0 +1,74 @@
+"""Closes a now-playing dashboard that has been showing next to idle playback for too long."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable, Coroutine
+from typing import Any
+
+
+class IdleDashboardCloser:
+    """
+    Ends a dashboard once its device's playback has been idle for a set time.
+
+    A Cast receiver loops its keepalive media for as long as a dashboard is open, which keeps
+    the device (and anything wired to it) awake. Playback going idle starts a timer, playback
+    coming back cancels it, and the dashboard is closed when the timer runs out.
+    """
+
+    def __init__(
+        self,
+        loop: asyncio.AbstractEventLoop,
+        idle_seconds: float,
+        close: Callable[[str], Coroutine[Any, Any, None]],
+    ) -> None:
+        """
+        Initialize the closer.
+
+        :param loop: The event loop the timers run on.
+        :param idle_seconds: How long playback may stay idle; zero or less disables closing.
+        :param close: Called with the key of a dashboard to close.
+        """
+        self._loop = loop
+        self._idle_seconds = idle_seconds
+        self._close = close
+        self._timers: dict[str, asyncio.TimerHandle] = {}
+        self._tasks: set[asyncio.Task[None]] = set()
+
+    def observe(self, key: str, *, playing: bool) -> None:
+        """
+        Record whether a dashboard's device is playing.
+
+        :param key: Identifies the dashboard.
+        :param playing: Whether something is playing on its device now.
+        """
+        if self._idle_seconds <= 0:
+            return
+        if playing:
+            self.forget(key)
+        elif key not in self._timers:
+            # the period counts from when playback went idle, not from each status after it
+            self._timers[key] = self._loop.call_later(self._idle_seconds, self._fire, key)
+
+    def forget(self, key: str) -> None:
+        """
+        Stop timing a dashboard, for example because it ended.
+
+        :param key: Identifies the dashboard.
+        """
+        if timer := self._timers.pop(key, None):
+            timer.cancel()
+
+    def stop(self) -> None:
+        """Cancel every pending close."""
+        for key in list(self._timers):
+            self.forget(key)
+        for task in list(self._tasks):
+            task.cancel()
+
+    def _fire(self, key: str) -> None:
+        """Start closing a dashboard whose device stayed idle."""
+        self._timers.pop(key, None)
+        task = self._loop.create_task(self._close(key))
+        self._tasks.add(task)
+        task.add_done_callback(self._tasks.discard)
