+package gotaglib
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/core/ffmpeg"
+)
+
+func TestParseDTSUsesProbedAudioPropertiesAndKeepsTags(t *testing.T) {
+	dir := t.TempDir()
+	fixture, err := os.ReadFile("../../tests/fixtures/test.wav")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const name = "multichannel.wav.dts"
+	if err := os.WriteFile(filepath.Join(dir, name), fixture, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	// Confirm the reproducer: TagLib succeeds but sees the WAV fixture's mono
+	// properties. DTS-in-WAV tracks have the same misleading successful parse.
+	e := extractor{fs: os.DirFS(dir), baseDir: dir}
+	initial, err := e.extractMetadata(name)
+	if err != nil {
+		t.Fatalf("TagLib precondition: %v", err)
+	}
+	if initial.AudioProperties.Channels != 1 {
+		t.Fatalf("TagLib precondition: expected mono WAV properties, got %d channels", initial.AudioProperties.Channels)
+	}
+
+	e.probeAudioStream = func(_ context.Context, path string) (*ffmpeg.AudioProbeResult, error) {
+		if path != filepath.Join(dir, name) {
+			t.Errorf("ffprobe path = %q", path)
+		}
+		return &ffmpeg.AudioProbeResult{
+			Codec: "dts", Channels: 6, SampleRate: 44100, BitDepth: 16, BitRate: 1411,
+		}, nil
+	}
+	parsed, err := e.Parse(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, ok := parsed[name]
+	if !ok {
+		t.Fatal("DTS track was omitted")
+	}
+	if info.AudioProperties.Codec != "dts" || info.AudioProperties.Channels != 6 || info.AudioProperties.SampleRate != 44100 {
+		t.Errorf("audio properties = %+v, want DTS 6ch/44100Hz", info.AudioProperties)
+	}
+	if got := info.Tags["title"]; len(got) != 1 || got[0] != "Title" {
+		t.Errorf("title tags = %v, want TagLib title preserved", got)
+	}
+	if got := info.Tags["album"]; len(got) != 1 || got[0] != "Album" {
+		t.Errorf("album tags = %v, want TagLib album preserved", got)
+	}
+}
+
+func TestParseDTSRejectsNonDTSPayload(t *testing.T) {
+	dir := t.TempDir()
+	fixture, err := os.ReadFile("../../tests/fixtures/test.wav")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const name = "misnamed.wav.dts"
+	if err := os.WriteFile(filepath.Join(dir, name), fixture, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	e := extractor{
+		fs: os.DirFS(dir), baseDir: dir,
+		probeAudioStream: func(context.Context, string) (*ffmpeg.AudioProbeResult, error) {
+			return &ffmpeg.AudioProbeResult{Codec: "pcm_s16le", Channels: 1}, nil
+		},
+	}
+	parsed, err := e.Parse(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(parsed) != 0 {
+		t.Errorf("misnamed non-DTS file should be omitted, got %#v", parsed)
+	}
+}
