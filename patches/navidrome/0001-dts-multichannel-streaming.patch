+// extractDTSProperties handles raw DTS elementary streams, which carry no
+// standard tags and are not readable by TagLib. The source itself remains
+// untouched; ffprobe supplies only the technical properties used for catalog
+// display and stream negotiation.
+func (e extractor) extractDTSProperties(filePath string) (*metadata.Info, error) {
+	fullPath := filepath.Join(e.baseDir, filepath.FromSlash(filePath))
+	probeFn := e.probeAudioStream
+	if probeFn == nil {
+		probeFn = ffmpeg.New().ProbeAudioStream
+	}
+	probe, err := probeFn(context.Background(), fullPath)
+	if err != nil {
+		log.Warn("gotaglib: ffprobe could not inspect DTS file", "filePath", filePath, err)
+		return nil, err
+	}
+	if !strings.EqualFold(probe.Codec, "dts") || probe.Channels < 1 {
+		return nil, fmt.Errorf("gotaglib: %q has .dts extension but ffprobe found codec %q with %d channels", filePath, probe.Codec, probe.Channels)
+	}
+	baseName := strings.TrimSuffix(filepath.Base(filePath), filepath.Ext(filePath))
+	album := filepath.Base(filepath.Dir(filePath))
+	return &metadata.Info{
+		Tags: model.RawTags{
+			"title": {baseName},
+			"album": {album},
+		},
+		AudioProperties: metadata.AudioProperties{
+			Duration:   time.Duration(probe.Duration * float64(time.Second)),
+			BitRate:    probe.BitRate,
+			BitDepth:   probe.BitDepth,
+			SampleRate: probe.SampleRate,
+			Channels:   probe.Channels,
+			Codec:      probe.Codec,
+		},
+	}, nil
+}
+
