diff --git a/src/components/AlphabetJumpBar.vue b/src/components/AlphabetJumpBar.vue
new file mode 100644
index 0000000..2003064
--- /dev/null
+++ b/src/components/AlphabetJumpBar.vue
@@ -0,0 +1,89 @@
+<template>
+  <div
+    class="alphabet-jump-bar"
+    role="navigation"
+    :aria-label="$t('tooltip.jump_to_letter')"
+  >
+    <button
+      v-for="letter in letters"
+      :key="letter"
+      type="button"
+      class="alphabet-jump-bar__letter"
+      :class="{ 'alphabet-jump-bar__letter--active': letter === active }"
+      :aria-current="letter === active ? 'true' : undefined"
+      :disabled="disabled"
+      @click="emit('jump', letter === TOP ? undefined : letter.toLowerCase())"
+    >
+      {{ letter }}
+    </button>
+  </div>
+</template>
+
+<script setup lang="ts">
+/**
+ * The A-Z strip that jumps a long listing to a letter.
+ *
+ * Leading "#" is the top of the listing rather than a letter of its own: names that
+ * start with a digit, and names like "!!!" that reduce to nothing once punctuation is
+ * stripped, all sort above "a", so starting from the beginning is where they are.
+ */
+const TOP = "#";
+const letters = [TOP, ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"];
+
+defineProps<{
+  /** The letter to mark as where the listing currently is, if any. */
+  active?: string;
+  /** Greys the strip out while the listing it drives is busy. */
+  disabled?: boolean;
+}>();
+
+const emit = defineEmits<{
+  /** A letter was picked; undefined means the top of the listing. */
+  (e: "jump", letter: string | undefined): void;
+}>();
+</script>
+
+<style scoped>
+.alphabet-jump-bar {
+  display: flex;
+  align-items: center;
+  gap: 1px;
+  padding: 4px 10px;
+  /* a library with every letter still fits a phone: the strip scrolls rather than wraps,
+     so the listing below it never moves down a row */
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.alphabet-jump-bar::-webkit-scrollbar {
+  display: none;
+}
+
+.alphabet-jump-bar__letter {
+  flex: 1 0 auto;
+  min-width: 22px;
+  padding: 2px 0;
+  border-radius: 4px;
+  font-size: 0.75rem;
+  line-height: 1.25rem;
+  font-variant-numeric: tabular-nums;
+  color: rgb(var(--v-theme-on-surface));
+  opacity: 0.6;
+}
+
+.alphabet-jump-bar__letter:hover:not(:disabled) {
+  opacity: 1;
+  background-color: rgba(var(--v-theme-on-surface), 0.08);
+}
+
+.alphabet-jump-bar__letter--active {
+  opacity: 1;
+  font-weight: 700;
+  background-color: rgba(var(--v-theme-primary), 0.16);
+  color: rgb(var(--v-theme-primary));
+}
+
+.alphabet-jump-bar__letter:disabled {
+  opacity: 0.3;
+}
+</style>
