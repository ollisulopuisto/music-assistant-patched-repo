diff --git a/src/helpers/alphabet_jump.ts b/src/helpers/alphabet_jump.ts
new file mode 100644
index 0000000..447e4bb
--- /dev/null
+++ b/src/helpers/alphabet_jump.ts
@@ -0,0 +1,48 @@
+/** Helpers for the A-Z strip that jumps a long library listing to a letter. */
+
+/** The sort keys a first letter means anything under; any other order scatters them. */
+export const NAME_SORT_KEYS = [
+  "name",
+  "name_desc",
+  "sort_name",
+  "sort_name_desc",
+];
+
+/**
+ * Return the same sort key in the opposite direction.
+ *
+ * :param sortBy: The sort key the listing is using.
+ */
+export function reverseSortKey(sortBy: string): string {
+  return sortBy.endsWith("_desc")
+    ? sortBy.slice(0, -"_desc".length)
+    : `${sortBy}_desc`;
+}
+
+/**
+ * Return the listing arguments that fetch the page above a jump.
+ *
+ * A jump asks for "this letter onwards", so there is nothing above the first item to page
+ * into. Asking for "before this letter" with the ordering reversed walks backwards from
+ * it instead, a page at a time, nearest first.
+ *
+ * :param params: The listing's current arguments, including the letter it jumped to.
+ * :param earlierOffset: How many items above the jump have already been fetched.
+ */
+export function earlierPageParams<
+  T extends {
+    sortBy: string;
+    startsFrom?: string;
+    startsBefore?: string;
+    offset: number;
+    limit: number;
+  },
+>(params: T, earlierOffset: number): T {
+  return {
+    ...params,
+    startsFrom: undefined,
+    startsBefore: params.startsFrom,
+    sortBy: reverseSortKey(params.sortBy),
+    offset: earlierOffset,
+  };
+}
