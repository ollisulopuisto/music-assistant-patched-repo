+// The buckets the first-letter filter offers. "#" collects everything the server files
+// under no letter - names starting with a digit, and names like "!!!" that reduce to
+// nothing once punctuation is stripped - so the strip as a whole reaches every item.
+const FIRST_LETTER_OTHER = "#";
+const FIRST_LETTER_BUCKETS = [
+  FIRST_LETTER_OTHER,
+  ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ",
+];
+
 export interface LoadDataParams {
   offset: number;
   limit: number;
   sortBy: string;
   search: string;
   genreIds?: number | number[];
+  // a single letter, or "#" for the items filed under no letter at all
+  startsWith?: string;
   favoritesOnly?: boolean;
   albumArtistsFilter?: boolean;
   libraryOnly?: boolean;
@@ -433,6 +445,7 @@ export interface Props {
   emptyMessage?: string;
   showLibraryOnlyFilter?: boolean;
   showGenreFilter?: boolean;
+  showFirstLetterFilter?: boolean;
