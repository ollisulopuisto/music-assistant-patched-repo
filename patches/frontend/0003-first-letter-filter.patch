   showHideFullyPlayedFilter?: boolean;
   allowCollapse?: boolean;
@@ -486,6 +499,7 @@ const props = withDefaults(defineProps<Props>(), {
   subtitle: undefined,
   showLibraryOnlyFilter: false,
   showGenreFilter: false,
+  showFirstLetterFilter: false,
   showHideEmptyFilter: false,
   showHideFullyPlayedFilter: false,
   extraMenuItems: undefined,
@@ -556,6 +570,7 @@ const params = ref<LoadDataParams>({
   search: "",
   libraryOnly: false,
   genreIds: undefined,
+  startsWith: undefined,
 });
 const viewMode = ref("list");
 const showSearch = ref(false);
@@ -938,6 +953,13 @@ const changeSort = function (sort_key?: string) {
   loadData(undefined, undefined, true);
 };
 
+const changeFirstLetterFilter = function (letter: string) {
+  // clicking the letter you are already on clears it, like the other toggle filters
+  params.value.startsWith =
+    params.value.startsWith === letter ? undefined : letter;
+  loadData(undefined, undefined, true);
+};
+
 const changeAlbumTypeFilter = function (albumType: string) {
   if (params.value.albumType?.includes(albumType))
     params.value.albumType = params.value.albumType?.filter(
@@ -1068,6 +1090,7 @@ const hasActiveFilters = computed(() => {
     (!props.requireProviderSelection && p.provider && p.provider.length > 0) ||
     (p.albumType && p.albumType.length > 0) ||
     genreActive ||
+    Boolean(p.startsWith) ||
     // hide-empty genres filter: true (hide empty) and null (defaults only)
     // both narrow the result; false/undefined means "show all"
     p.hideEmptyFilter === true ||
@@ -1443,6 +1466,28 @@ const menuItems = computed(() => {
     });
   }
 
+  // jump to a first letter: a big library is many pages deep, and scrolling is the
+  // only way to reach the far end of the alphabet without it
+  if (props.showFirstLetterFilter === true) {
+    items.push({
+      label: "tooltip.filter_first_letter",
+      icon: ArrowDownAZ,
+      disabled: loading.value,
+      active: params.value.startsWith !== undefined,
+      closeOnContentClick: false,
+      overflowAllowed: true,
+      subItems: FIRST_LETTER_BUCKETS.map((letter) => {
+        return {
+          // a bare letter is not a translation key; $t falls through to it unchanged,
+          // the same way the genre filter passes raw genre names
+          label: letter,
+          selected: params.value.startsWith === letter.toLowerCase(),
+          action: () => changeFirstLetterFilter(letter.toLowerCase()),
+        };
+      }),
+    });
+  }
+
   // toggle search (auto-hidden for small listings)
   if (searchAvailable.value) {
     items.push({
