index 0000000..252a350
--- /dev/null
+++ b/src/helpers/page_jump.ts
@@ -0,0 +1,45 @@
+/** Helpers for the numbered strip that jumps a long playlist to a page of its items. */
+
+/** The sort keys a page number means anything under: the playlist's own order. */
+export const POSITION_SORT_KEYS = ["position", "position_desc"];
+
+/**
+ * Return the offset each chip of the strip jumps to: one per page of the listing.
+ *
+ * :param total: How many items the listing holds.
+ * :param pageSize: How many items a page loads.
+ */
+export function pageJumpOffsets(total: number, pageSize: number): number[] {
+  const offsets: number[] = [];
+  for (let offset = 0; offset < total; offset += pageSize) {
+    offsets.push(offset);
+  }
+  return offsets;
+}
+
+/**
+ * Return whether the numbered strip is useful for a listing.
+ *
+ * It is only meaningful in the playlist's own order, without a search (a search makes the
+ * total wrong), and only when there is more than one page to jump between.
+ *
+ * :param args.sortBy: The sort key the listing is using.
+ * :param args.search: The search text, if any.
+ * :param args.total: The number of items in the playlist, if known.
+ * :param args.pageSize: How many items a page loads.
+ */
+export function pageJumpAvailable({
+  sortBy,
+  search,
+  total,
+  pageSize,
+}: {
+  sortBy: string;
+  search?: string;
+  total?: number;
+  pageSize: number;
+}): boolean {
+  if (!POSITION_SORT_KEYS.includes(sortBy)) return false;
+  if (search) return false;
+  return total !== undefined && total > pageSize;
+}
