+import { mount } from "@vue/test-utils";
+import { beforeEach, describe, expect, it } from "vitest";
+import PageJumpBar from "@/components/PageJumpBar.vue";
+import { i18n } from "@/plugins/i18n";
+
+beforeEach(() => {
+  i18n.global.locale.value = "en";
+});
+
+describe("PageJumpBar", () => {
+  it("labels each chip with the position of its first item", () => {
+    const wrapper = mount(PageJumpBar, {
+      props: { offsets: [0, 50, 100] },
+      global: { plugins: [i18n] },
+    });
+
+    expect(wrapper.findAll("button").map((b) => b.text())).toEqual([
+      "1",
+      "51",
+      "101",
+    ]);
+  });
+
+  it("emits the offset of the chip that was tapped", async () => {
+    const wrapper = mount(PageJumpBar, {
+      props: { offsets: [0, 50, 100] },
+      global: { plugins: [i18n] },
+    });
+
+    await wrapper.findAll("button")[2].trigger("click");
+
+    expect(wrapper.emitted("jump")).toEqual([[100]]);
+  });
+
+  it("marks the active chip and greys the strip out while busy", () => {
+    const wrapper = mount(PageJumpBar, {
+      props: { offsets: [0, 50], active: 50, disabled: true },
+      global: { plugins: [i18n] },
+    });
+
+    const chips = wrapper.findAll("button");
+    expect(chips[1].classes()).toContain("page-jump-bar__chip--active");
+    expect(chips[1].attributes("aria-current")).toBe("true");
+    expect(chips[0].attributes("disabled")).toBeDefined();
+  });
+});
