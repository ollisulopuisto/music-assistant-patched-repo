+// The numbered strip for a long playlist in its own order: one chip per page, so the far end
+// of the list is reachable without paging through it. It needs the total, which the parent
+// passes in, and it is hidden while a search narrows the list.
+const pageJumpShown = computed(
+  () =>
+    props.showPageJump &&
+    pageJumpAvailable({
+      sortBy: params.value.sortBy,
+      search: params.value.search,
+      total: props.total,
+      pageSize: props.limit,
+    }),
+);
+const pageJumpChips = computed(() =>
+  pageJumpShown.value ? pageJumpOffsets(props.total ?? 0, props.limit) : [],
+);
+// the page the listing was last jumped to, which the strip marks
+const activePageOffset = ref(0);
+
+/**
+ * Replace the listing with the page starting at offset, then scroll to it.
+ *
+ * Paging on from there goes through loadNextPage as usual, since params.offset now sits at
+ * the page the jump landed on.
+ */
+const jumpToPage = async function (offset: number) {
+  // loadData drops a call made while another load runs, so clearing the list now would leave
+  // it empty; the strip is disabled while loading, so this only guards a race
+  if (loading.value) return;
+  activePageOffset.value = offset;
+  allItemsReceived.value = false;
+  pagedItems.value = [];
+  await loadData(false, false, false, offset);
+  scrollListingIntoView();
+};
+
 // The bucket of whatever item is currently under the strip, once the listing has been
 // scrolled. Until then there is nothing to read, and the strip marks where the listing
 // begins instead.
