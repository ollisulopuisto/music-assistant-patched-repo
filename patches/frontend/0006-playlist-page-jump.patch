@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+
+import { pageJumpAvailable, pageJumpOffsets } from "@/helpers/page_jump";
+
+describe("pageJumpOffsets", () => {
+  it("starts a chip at every full page of the listing", () => {
+    expect(pageJumpOffsets(120, 50)).toEqual([0, 50, 100]);
+  });
+
+  it("gives no chips for an empty listing", () => {
+    expect(pageJumpOffsets(0, 50)).toEqual([]);
+  });
+
+  it("adds no chip past the last item when the total is a whole number of pages", () => {
+    expect(pageJumpOffsets(100, 50)).toEqual([0, 50]);
+  });
+});
+
+describe("pageJumpAvailable", () => {
+  const base = {
+    sortBy: "position",
+    search: undefined,
+    total: 51,
+    pageSize: 50,
+  };
+
+  it("is on for a playlist longer than one page in position order", () => {
+    expect(pageJumpAvailable(base)).toBe(true);
+    expect(pageJumpAvailable({ ...base, sortBy: "position_desc" })).toBe(true);
+  });
+
+  it("is off for a playlist that fits one page", () => {
+    expect(pageJumpAvailable({ ...base, total: 50 })).toBe(false);
+    expect(pageJumpAvailable({ ...base, total: 0 })).toBe(false);
+  });
+
+  it("is off for any other sort, which keeps the A-Z strip or nothing", () => {
+    expect(pageJumpAvailable({ ...base, sortBy: "name" })).toBe(false);
+    expect(pageJumpAvailable({ ...base, sortBy: "duration" })).toBe(false);
+  });
+
+  it("is off while a search narrows the list, since the total no longer applies", () => {
+    expect(pageJumpAvailable({ ...base, search: "jam" })).toBe(false);
+  });
+
+  it("is off while the total is not known yet", () => {
+    expect(pageJumpAvailable({ ...base, total: undefined })).toBe(false);
+  });
+});
