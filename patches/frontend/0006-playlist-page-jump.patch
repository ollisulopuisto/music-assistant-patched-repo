+// how many items the playlist holds, for the numbered jump strip; undefined until counted
+const playlistTotal = ref<number>();
+// the playlist the count was last asked for, so a new search or sort does not count it again
+let countedItemId: string | undefined;
+
+const refreshPlaylistTotal = function (forceRefresh?: boolean) {
+  const itemId = props.itemId;
+  countedItemId = itemId;
+  api
+    .getPlaylistTracksCount(itemId, props.provider, forceRefresh)
+    .then((count) => {
+      // the route may have moved on to another playlist while the count was read
+      if (itemId === props.itemId) playlistTotal.value = count;
+    })
+    .catch(() => {
+      if (itemId === props.itemId) playlistTotal.value = undefined;
+    });
+};
+
 const loadPlaylistTracksPage = async function (params: LoadDataParams) {
+  // counted alongside the first page, not before it, so the list does not wait for the count
+  if (
+    params.offset === 0 &&
+    (params.refresh || countedItemId !== props.itemId)
+  ) {
+    // another playlist's count must not drive the strip while this one is counted
+    if (countedItemId !== props.itemId) playlistTotal.value = undefined;
+    refreshPlaylistTotal(params.refresh);
+  }
   return await api.getPlaylistTracksPage(
     props.itemId,
     props.provider,
