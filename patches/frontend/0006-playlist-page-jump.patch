+<template>
+  <div
+    class="page-jump-bar"
+    role="navigation"
+    :aria-label="$t('tooltip.jump_to_page')"
+  >
+    <button
+      v-for="offset in offsets"
+      :key="offset"
+      type="button"
+      class="page-jump-bar__chip"
+      :class="{ 'page-jump-bar__chip--active': offset === active }"
+      :aria-current="offset === active ? 'true' : undefined"
+      :disabled="disabled"
+      @click="emit('jump', offset)"
+    >
+      {{ offset + 1 }}
+    </button>
+  </div>
+</template>
+
+<script setup lang="ts">
+/**
+ * The numbered strip that jumps a long playlist to a page of its items.
+ *
+ * One chip per page, labelled with the position of its first item (1, 51, 101, ...). It sits
+ * in the listing header with the A-Z strip's look, and scrolls sideways when there are many.
+ */
+defineProps<{
+  /** The offset each chip jumps to, from the top of the listing. */
+  offsets: number[];
+  /** The offset of the chip to mark as where the listing is, if any. */
+  active?: number;
+  /** Greys the strip out while the listing it drives is busy. */
+  disabled?: boolean;
+}>();
+
+const emit = defineEmits<{
+  (e: "jump", offset: number): void;
+}>();
+</script>
