diff --git a/tests/helpers/now_playing_details.test.ts b/tests/helpers/now_playing_details.test.ts
new file mode 100644
index 0000000..3b08ea5
--- /dev/null
+++ b/tests/helpers/now_playing_details.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  formatStreamLine,
+  nowPlayingArtwork,
+} from "@/helpers/now_playing_details";
+
+describe("formatStreamLine", () => {
+  it("shows codec, sample rate, bit depth and bitrate for lossless audio", () => {
+    expect(
+      formatStreamLine({
+        content_type: "flac",
+        sample_rate: 96000,
+        bit_depth: 24,
+        bit_rate: 2300,
+      }),
+    ).toBe("FLAC · 96 kHz · 24-bit · 2300 kbps");
+  });
+
+  it("leaves the bit depth out for lossy audio", () => {
+    expect(
+      formatStreamLine({
+        content_type: "mp3",
+        sample_rate: 44100,
+        bit_depth: 16,
+        bit_rate: 320,
+      }),
+    ).toBe("MP3 · 44.1 kHz · 320 kbps");
+  });
+
+  it("omits the bitrate when it is not known", () => {
+    expect(
+      formatStreamLine({
+        content_type: "pcm_s16le",
+        sample_rate: 48000,
+        bit_depth: 16,
+        bit_rate: null,
+      }),
+    ).toBe("PCM · 48 kHz · 16-bit");
+  });
+
+  it("is empty when no format is known", () => {
+    expect(formatStreamLine(undefined)).toBe("");
+    expect(formatStreamLine(null)).toBe("");
+  });
+});
+
+describe("nowPlayingArtwork", () => {
+  it("prefers the artist image over the album art", () => {
+    expect(
+      nowPlayingArtwork(
+        { artist_image_url: "https://img.test/artist.jpg" },
+        "https://img.test/album.jpg",
+      ),
+    ).toBe("https://img.test/artist.jpg");
+  });
+
+  it("falls back to the album art when there is no artist image", () => {
+    expect(nowPlayingArtwork({}, "https://img.test/album.jpg")).toBe(
+      "https://img.test/album.jpg",
+    );
+    expect(nowPlayingArtwork(undefined, "https://img.test/album.jpg")).toBe(
+      "https://img.test/album.jpg",
+    );
+  });
+
+  it("is null when neither is known", () => {
+    expect(nowPlayingArtwork({}, null)).toBeNull();
+  });
+});
