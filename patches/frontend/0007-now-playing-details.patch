+/** Helpers for the details the now-playing dashboard shows beyond the title and cover. */
+
+/** The stream format the server reports in a now-playing item's custom data. */
+export interface StreamFormat {
+  content_type: string;
+  sample_rate: number;
+  bit_depth: number;
+  bit_rate: number | null;
+}
+
+// codecs that keep every sample, so the bit depth says something about the audio
+const LOSSLESS_CODECS = ["flac", "alac", "wav", "aiff", "dsf", "dff"];
+
+/**
+ * Return a one-line description of the stream, such as "FLAC · 96 kHz · 24-bit · 2300 kbps".
+ *
+ * The bit depth is only shown for lossless codecs, where it means something; lossy codecs
+ * show their bitrate instead. Anything not known is left out, and nothing known gives "".
+ *
+ * :param format: The stream format, or null/undefined when the server has not reported one.
+ */
+export function formatStreamLine(
+  format: StreamFormat | null | undefined,
+): string {
+  if (!format) return "";
+  const codec = format.content_type.toLowerCase();
+  const lossless = codec.startsWith("pcm") || LOSSLESS_CODECS.includes(codec);
+  const parts: string[] = [];
+  if (codec && codec !== "unknown") {
+    parts.push(codec.startsWith("pcm") ? "PCM" : codec.toUpperCase());
+  }
+  if (format.sample_rate > 0) {
+    parts.push(`${Number((format.sample_rate / 1000).toFixed(1))} kHz`);
+  }
+  if (lossless && format.bit_depth > 0) {
+    parts.push(`${format.bit_depth}-bit`);
+  }
+  if (format.bit_rate) {
+    parts.push(`${format.bit_rate} kbps`);
+  }
+  return parts.join(" · ");
+}
+
+/**
+ * Return the image the dashboard should show big: the artist's portrait when the server has
+ * one, otherwise the album art.
+ *
+ * :param customData: The now-playing item's custom data from the server, if any.
+ * :param albumImageUrl: The album art URL the server reports for the item.
+ */
+export function nowPlayingArtwork(
+  customData: Record<string, unknown> | null | undefined,
+  albumImageUrl: string | null,
+): string | null {
+  const artist = customData?.artist_image_url;
+  if (typeof artist === "string" && artist) return artist;
+  return albumImageUrl || null;
+}
