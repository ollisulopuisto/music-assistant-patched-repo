index b77aaf0..6b77bb5 100644
--- a/src/helpers/now_playing_details.ts
+++ b/src/helpers/now_playing_details.ts
@@ -56,3 +56,17 @@ export function nowPlayingArtwork(
   if (typeof artist === "string" && artist) return artist;
   return albumImageUrl || null;
 }
+
+/**
+ * Return the image proxy URL asking for its largest size.
+ *
+ * The server hands players 512 px covers, which look soft once the dashboard stretches them
+ * across half a TV. The proxy accepts 1024, so a proxy URL with a size is moved up to it.
+ * Anything that is not an image proxy URL, or has no size to replace, comes back unchanged.
+ *
+ * :param url: The image URL.
+ */
+export function largeImageUrl(url: string): string {
+  if (!url.includes("/imageproxy") || !/[?&]size=\d+/.test(url)) return url;
+  return url.replace(/([?&])size=\d+/, "$1size=1024");
+}
