+
+describe("largeImageUrl", () => {
+  it("asks the image proxy for the 1024 size instead of the 512 one", () => {
+    expect(
+      largeImageUrl("https://ma.test/imageproxy/abc123?size=512&fmt=jpg"),
+    ).toBe("https://ma.test/imageproxy/abc123?size=1024&fmt=jpg");
+  });
+
+  it("handles the legacy query-string proxy form", () => {
+    expect(
+      largeImageUrl("https://ma.test/imageproxy?provider=x&size=512&path=p"),
+    ).toBe("https://ma.test/imageproxy?provider=x&size=1024&path=p");
+  });
+
+  it("leaves URLs that are not from the image proxy alone", () => {
+    expect(largeImageUrl("https://example.test/cover.jpg?size=512")).toBe(
+      "https://example.test/cover.jpg?size=512",
+    );
+  });
+
+  it("leaves a proxy URL without a size alone", () => {
+    expect(largeImageUrl("https://ma.test/imageproxy/abc123?fmt=jpg")).toBe(
+      "https://ma.test/imageproxy/abc123?fmt=jpg",
+    );
+  });
+
+  it("returns an empty string unchanged", () => {
+    expect(largeImageUrl("")).toBe("");
+  });
+});
