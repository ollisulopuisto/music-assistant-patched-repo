  */
 export function bucketOf(
-  item: { name?: string; sort_name?: string },
+  item: {
+    name?: string;
+    sort_name?: string;
+    artists?: { name?: string; sort_name?: string }[] | null;
+    album?: { name?: string; sort_name?: string } | null;
+  },
   sortBy: string,
 ): string {
-  const usesPlainName = sortBy === "name" || sortBy === "name_desc";
-  const source = usesPlainName ? item.name : (item.sort_name ?? item.name);
+  const source = bucketSource(item, sortBy);
   const normalised = (source ?? "")
     .normalize("NFD")
     .replace(/\p{Diacritic}/gu, "")
