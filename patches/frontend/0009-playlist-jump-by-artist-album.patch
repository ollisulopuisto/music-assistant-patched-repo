diff --git a/tests/helpers/alphabet_jump.test.ts b/tests/helpers/alphabet_jump.test.ts
new file mode 100644
index 0000000..601e9e1
--- /dev/null
+++ b/tests/helpers/alphabet_jump.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  NAME_SORT_KEYS,
+  PLAYLIST_LETTER_SORT_KEYS,
+  TOP_BUCKET,
+  bucketOf,
+} from "@/helpers/alphabet_jump";
+
+describe("bucketOf", () => {
+  it("files a track by its first artist when the listing is sorted by artist", () => {
+    const track = { name: "Song", artists: [{ name: "Kate Bush" }] };
+    expect(bucketOf(track, "artist")).toBe("K");
+    expect(bucketOf(track, "artist_desc")).toBe("K");
+  });
+
+  it("files a track by its album when the listing is sorted by album", () => {
+    const track = { name: "Song", album: { name: "Kilo" } };
+    expect(bucketOf(track, "album")).toBe("K");
+    expect(bucketOf(track, "album_desc")).toBe("K");
+  });
+
+  it("prefers the artist's sort name, as the server does", () => {
+    const track = {
+      name: "Song",
+      artists: [{ name: "The Beatles", sort_name: "Beatles, The" }],
+    };
+    expect(bucketOf(track, "artist")).toBe("B");
+  });
+
+  it("folds accents on the artist the way the server does", () => {
+    expect(bucketOf({ artists: [{ name: "Ärtig" }] }, "artist")).toBe("A");
+  });
+
+  it("puts a track with no artist or album at the top of the listing", () => {
+    expect(bucketOf({ name: "Radio", artists: [] }, "artist")).toBe(TOP_BUCKET);
+    expect(bucketOf({ name: "Radio", album: null }, "album")).toBe(TOP_BUCKET);
+  });
+
+  it("still files by the track name for the name orders", () => {
+    const track = {
+      name: "Zebra",
+      artists: [{ name: "Kate Bush" }],
+      album: { name: "Kilo" },
+    };
+    expect(bucketOf(track, "name")).toBe("Z");
+  });
+});
+
+describe("sort keys the letter strip offers", () => {
+  it("adds artist and album to a playlist's keys but not to the library's", () => {
+    expect(PLAYLIST_LETTER_SORT_KEYS).toEqual(
+      expect.arrayContaining(["artist", "artist_desc", "album", "album_desc"]),
+    );
+    expect(NAME_SORT_KEYS).not.toContain("artist");
+    expect(NAME_SORT_KEYS).not.toContain("album");
+  });
+
+  it("keeps the name keys in a playlist's", () => {
+    expect(PLAYLIST_LETTER_SORT_KEYS).toEqual(
+      expect.arrayContaining(NAME_SORT_KEYS),
+    );
+  });
+});
