@@ -11,6 +11,21 @@ export const NAME_SORT_KEYS = [
   "sort_name_desc",
 ];
 
+/**
+ * The sort keys a playlist's letter strip works under: the name orders, plus artist and album.
+ *
+ * A playlist's contents are sorted and cut on the server, which files each item by the name
+ * the order follows, so a jump to K in artist order means artists starting with K. The
+ * library listings filter by the track's own name column and keep to NAME_SORT_KEYS.
+ */
+export const PLAYLIST_LETTER_SORT_KEYS = [
+  ...NAME_SORT_KEYS,
+  "artist",
+  "artist_desc",
+  "album",
+  "album_desc",
+];
+
 /**
  * Return the same sort key in the opposite direction.
  *
@@ -50,6 +65,28 @@ export function earlierPageParams<
   };
 }
 
+/** Return the name an item is filed under, following the order the listing is sorted by. */
+function bucketSource(
+  item: {
+    name?: string;
+    sort_name?: string;
+    artists?: { name?: string; sort_name?: string }[] | null;
+    album?: { name?: string; sort_name?: string } | null;
+  },
+  sortBy: string,
+): string | undefined {
+  if (sortBy === "artist" || sortBy === "artist_desc") {
+    const artist = item.artists?.[0];
+    return artist ? (artist.sort_name ?? artist.name) : undefined;
+  }
+  if (sortBy === "album" || sortBy === "album_desc") {
+    return item.album ? (item.album.sort_name ?? item.album.name) : undefined;
+  }
+  return sortBy === "name" || sortBy === "name_desc"
+    ? item.name
+    : (item.sort_name ?? item.name);
+}
+
 /**
  * Return the strip bucket an item is filed under.
  *
@@ -62,11 +99,15 @@ export function earlierPageParams<
