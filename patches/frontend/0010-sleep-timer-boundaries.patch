-  public setSleepTimer(playerId: string, seconds: number): Promise<number> {
+  public setSleepTimer(
+    playerId: string,
+    seconds: number,
+    mode: SleepTimerMode = "duration",
+  ): Promise<number> {
     /*
-      Set a sleep timer that stops playback after the given number of seconds.
+      Set a sleep timer. By default it stops playback after the given number of
+      seconds. With mode track_end or album_end it stops at the end of the
+      playing track (or chapter) or album, and with fit at the last track or
+      chapter end that comes within the given seconds.
       Returns the expiry (unix utc timestamp).
     */
     return this.sendCommand("players/sleep_timer/set", {
       player_id: playerId,
       seconds,
+      mode,
     });
   }
 
