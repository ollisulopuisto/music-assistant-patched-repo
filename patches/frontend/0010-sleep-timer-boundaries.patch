diff --git a/tests/helpers/sleep_timer.test.ts b/tests/helpers/sleep_timer.test.ts
new file mode 100644
index 0000000..44af42f
--- /dev/null
+++ b/tests/helpers/sleep_timer.test.ts
@@ -0,0 +1,43 @@
+import { getSleepTimerMenuItems } from "@/helpers/sleep_timer";
+import api from "@/plugins/api";
+import type { Player } from "@/plugins/api/interfaces";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/plugins/api", () => {
+  const api = { setSleepTimer: vi.fn(), clearSleepTimer: vi.fn() };
+  return { api, default: api };
+});
+
+const player = { player_id: "p1", sleep_timer_expires_at: null } as Player;
+
+const find = (label: string) =>
+  getSleepTimerMenuItems(player).find((item) => item.label === label);
+
+describe("sleep timer menu", () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  it("keeps the plain countdown presets", () => {
+    find("sleep_timer_preset.30")!.action!();
+    expect(api.setSleepTimer).toHaveBeenCalledWith("p1", 1800);
+  });
+
+  it("offers to stop at the end of the track or chapter", () => {
+    find("sleep_timer_track_end")!.action!();
+    expect(api.setSleepTimer).toHaveBeenCalledWith("p1", 0, "track_end");
+  });
+
+  it("offers to stop at the end of the album", () => {
+    find("sleep_timer_album_end")!.action!();
+    expect(api.setSleepTimer).toHaveBeenCalledWith("p1", 0, "album_end");
+  });
+
+  it("offers to finish the last track or chapter that ends within a time", () => {
+    const sub = find("sleep_timer_fit")!.subItems!;
+    expect(sub.length).toBeGreaterThan(0);
+    const thirty = sub.find(
+      (item) => item.label === "sleep_timer_fit_preset.30",
+    )!;
+    thirty.action!();
+    expect(api.setSleepTimer).toHaveBeenCalledWith("p1", 1800, "fit");
+  });
+});
